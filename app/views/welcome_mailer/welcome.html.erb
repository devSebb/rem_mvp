<% content_for :preview_title, "Bienvenido a Papayal" %>
<% content_for :preheader do %>Tu cuenta ya está lista para enviar tarjetas de regalo digitales.<% end %>

<!-- Eyebrow -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Tu cuenta está lista
</div>

<h1 style="margin:0 0 18px 0; font-size:30px; line-height:1.2; font-weight:800; letter-spacing:-0.8px; color:#0D2F32;">
  ¡Bienvenido a Papayal,<br><%= @first_name %>!
</h1>

<p style="margin:0 0 18px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Gracias por unirte. Ya puedes enviar y administrar tarjetas de regalo digitales
  para comercios afiliados en todo Ecuador — en segundos y con respaldo.
</p>

<!-- What you can do -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 28px 0;">
  <tr>
    <td style="padding:14px 0; border-top:1px solid #F1E2CB;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
        <td width="34" valign="top" style="font-size:20px; line-height:1;">🎁</td>
        <td style="font-size:15px; line-height:1.55; color:#2C3A43;">
          <strong style="color:#0D2F32;">Envía una tarjeta</strong> a quien quieras, con el monto que elijas.
        </td>
      </tr></table>
    </td>
  </tr>
  <tr>
    <td style="padding:14px 0; border-top:1px solid #F1E2CB;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
        <td width="34" valign="top" style="font-size:20px; line-height:1;">📲</td>
        <td style="font-size:15px; line-height:1.55; color:#2C3A43;">
          <strong style="color:#0D2F32;">Canjea al instante</strong> mostrando un código QR vigente desde la app.
        </td>
      </tr></table>
    </td>
  </tr>
  <tr>
    <td style="padding:14px 0; border-top:1px solid #F1E2CB; border-bottom:1px solid #F1E2CB;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
        <td width="34" valign="top" style="font-size:20px; line-height:1;">🔒</td>
        <td style="font-size:15px; line-height:1.55; color:#2C3A43;">
          <strong style="color:#0D2F32;">Todo respaldado</strong> — tus tarjetas y saldos quedan seguros en tu cuenta.
        </td>
      </tr></table>
    </td>
  </tr>
</table>

<!-- CTA -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 4px 0;">
  <tr>
    <td align="center" bgcolor="#FCA50F" style="border-radius:999px;">
      <a href="https://papayal.app" class="pyl-btn"
         style="display:inline-block; padding:15px 38px; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:700; color:#3A1E00; text-decoration:none; border-radius:999px;">
        Abrir Papayal
      </a>
    </td>
  </tr>
</table>
