<% content_for :preview_title, "Tu cuenta Papayal fue activada" %>
<% content_for :preheader do %>Tus tarjetas de regalo ya están disponibles en tu cuenta.<% end %>

<!-- Eyebrow -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Cuenta activada
</div>

<h1 style="margin:0 0 18px 0; font-size:28px; line-height:1.2; font-weight:800; letter-spacing:-0.8px; color:#0D2F32;">
  Tu cuenta fue activada
</h1>

<p style="margin:0 0 18px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Hola,
</p>

<p style="margin:0 0 18px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Tu cuenta Papayal fue activada y las tarjetas de regalo que te esperaban
  ya están disponibles en ella.
</p>

<p style="margin:0 0 18px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Si no fuiste tú quien activó la cuenta, escríbenos de inmediato a
  <a href="mailto:<%= @support_email %>" style="color:#E08A00; font-weight:600; text-decoration:none;"><%= @support_email %></a>.
</p>
