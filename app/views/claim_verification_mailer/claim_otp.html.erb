<% content_for :preview_title, "Tu código de verificación Papayal" %>
<% content_for :preheader do %>Tu código de verificación vence en 10 minutos.<% end %>

<!-- Eyebrow -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Verifica tu identidad
</div>

<h1 style="margin:0 0 18px 0; font-size:28px; line-height:1.2; font-weight:800; letter-spacing:-0.8px; color:#0D2F32;">
  Tu código de verificación
</h1>

<p style="margin:0 0 8px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Usa este código para verificar tu identidad en Papayal:
</p>

<!-- OTP box -->
<div style="text-align:center; background:#FDF1E1; color:#0D2F32; font-size:34px; letter-spacing:10px; font-weight:800; border-radius:14px; padding:18px 0; margin:20px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <%= @otp %>
</div>

<p style="margin:0 0 8px 0; font-size:15px; line-height:1.6; color:#6A7780;">
  Vence en 10 minutos. Si no intentaste crear una cuenta, ignora este mensaje.
</p>
