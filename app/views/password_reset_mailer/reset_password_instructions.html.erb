<% content_for :preview_title, "Restablece tu contraseña Papayal" %>
<% content_for :preheader do %>Tu código de recuperación vence en 6 horas.<% end %>

<!-- Eyebrow -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Recuperación de contraseña
</div>

<h1 style="margin:0 0 18px 0; font-size:28px; line-height:1.2; font-weight:800; letter-spacing:-0.8px; color:#0D2F32;">
  Restablece tu contraseña
</h1>

<p style="margin:0 0 18px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Hola <%= @user.name || @user.email %>,
</p>

<p style="margin:0 0 20px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Recibimos una solicitud para restablecer la contraseña de tu cuenta de Papayal. Copia el código de abajo y pégalo en la app para crear una nueva contraseña.
</p>

<!-- Recovery code -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="padding:18px 20px; background-color:#FDF1E1; border:1px solid #F1E2CB; border-radius:14px;">
      <div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:8px;">
        Tu código de recuperación
      </div>
      <div style="font-family:'Courier New',Courier,monospace; font-size:18px; font-weight:700; color:#0D2F32; word-break:break-all;">
        <%= @token %>
      </div>
    </td>
  </tr>
</table>

<!-- How to reset -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:12px;">
  Cómo restablecer tu contraseña
</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">1</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Abre la app de Papayal.</td>
  </tr>
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">2</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Ve a <strong style="color:#0D2F32;">Iniciar sesión → ¿Olvidaste tu contraseña? → Ya tengo mi código</strong>.</td>
  </tr>
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">3</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Pega el código de arriba y elige tu nueva contraseña.</td>
  </tr>
</table>

<!-- CTA -->
<p style="margin:0 0 14px 0; font-size:15px; line-height:1.6; color:#2C3A43; text-align:center;">
  ¿Tienes la app instalada? Toca el botón desde tu teléfono y te llevamos directo:
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 28px auto;">
  <tr>
    <td align="center" bgcolor="#FCA50F" style="border-radius:999px;">
      <a href="<%= @reset_url %>" class="pyl-btn"
         style="display:inline-block; padding:15px 38px; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:700; color:#3A1E00; text-decoration:none; border-radius:999px;">
        Restablecer en la app
      </a>
    </td>
  </tr>
</table>

<!-- Warning -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 4px 0;">
  <tr>
    <td style="padding:16px 18px; background-color:#FDF1E1; border:1px solid #F1E2CB; border-radius:12px; font-size:14px; line-height:1.7; color:#2C3A43;">
      <strong style="color:#0D2F32;">Importante:</strong><br>
      • Este código vence en 6 horas.<br>
      • Si no solicitaste este cambio, puedes ignorar este correo.<br>
      • Tu contraseña no cambiará hasta que completes el proceso en la app.
    </td>
  </tr>
</table>
