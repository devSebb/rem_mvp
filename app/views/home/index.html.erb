<%# Admins are redirected to /admin (Admin::DashboardController) before this view renders. %>
<% if user_signed_in? %>
  <% total_sent = current_user.sent_gift_cards.count %>
  <% total_received = current_user.received_gift_cards.count %>
  <% active_cards = current_user.received_gift_cards.active.count %>
  <% remaining_balance = current_user.received_gift_cards.sum(:remaining_balance).to_f / 100 %>
  <div class="space-y-10">
    <div class="papayal-card p-8 grid grid-cols-12 gap-6 items-center">
      <div class="col-span-12 lg:col-span-8">
        <p class="papayal-meta text-[#0D2F32]">Tu panel</p>
        <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">Hola, <%= current_user.name.split.first %></h1>
        <p class="text-base text-[#2C3A43]/80 mt-3">
          Gestiona tus tarjetas Papayal con seguridad premium y claridad total.
        </p>
      </div>
      <div class="col-span-12 lg:col-span-4 flex flex-wrap gap-3 justify-start lg:justify-end">
        <%= link_to "Mi Billetera", gift_cards_path, class: "papayal-btn-secondary w-full sm:w-auto" %>
        <span class="text-xs text-[#2C3A43]/60 self-center">Compra desde la app móvil Papayal</span>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
        <p class="papayal-meta">Saldo Disponible</p>
        <p class="text-3xl font-bold mt-2"><%= number_to_currency(remaining_balance, unit: '$') %></p>
        <p class="text-sm text-[#2C3A43]/70 mt-2">Suma de tus tarjetas activas</p>
      </div>
      <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
        <p class="papayal-meta">Tarjetas Activas</p>
        <p class="text-3xl font-bold mt-2"><%= active_cards %></p>
        <p class="text-sm text-[#2C3A43]/70 mt-2">Listas para canjear</p>
      </div>
      <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
        <p class="papayal-meta">Enviadas</p>
        <p class="text-3xl font-bold mt-2"><%= total_sent %></p>
        <p class="text-sm text-[#2C3A43]/70 mt-2">Regalos compartidos</p>
      </div>
      <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
        <p class="papayal-meta">Recibidas</p>
        <p class="text-3xl font-bold mt-2"><%= total_received %></p>
        <p class="text-sm text-[#2C3A43]/70 mt-2">Tarjetas en tu poder</p>
      </div>
    </div>

    <%# App Download CTA — visible to all signed-in regular users so they can
        complete the experience on mobile (purchases happen on the app only). %>
    <div class="papayal-card p-6 bg-gradient-to-r from-[#0D2F32] to-[#15353A] text-white">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-8">
        <div class="flex-shrink-0 h-16 w-16 rounded-2xl bg-[#FCA50F]/20 flex items-center justify-center text-3xl">
          📱
        </div>
        <div class="flex-1 min-w-0">
          <p class="papayal-meta text-white/70">Tu Papayal en el bolsillo</p>
          <h2 class="text-2xl font-bold mt-1">Descarga la app móvil</h2>
          <p class="text-sm text-white/80 mt-2 max-w-xl">
            Compra tarjetas de regalo, escanea códigos en caja y recibe notificaciones al instante. Toda tu billetera, lista cuando la necesites.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 flex-shrink-0">
          <%# TODO: replace "#" with App Store and Google Play URLs once published %>
          <%= link_to("#", class: "papayal-btn-primary text-sm", target: "_blank", rel: "noopener") do %>
            <span class="flex items-center gap-2">
              <span></span>
              <span>App Store</span>
            </span>
          <% end %>
          <%= link_to("#", class: "papayal-btn-secondary text-sm", target: "_blank", rel: "noopener") do %>
            <span class="flex items-center gap-2">
              <span>▶</span>
              <span>Google Play</span>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Merchant Grid Section %>
    <% if @merchants&.any? %>
      <div class="papayal-card p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="papayal-meta">Comercios</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Dónde comprar</h2>
          </div>
        </div>
        <div class="grid grid-cols-12 gap-4">
          <% @merchants.each do |merchant| %>
            <div class="col-span-12 sm:col-span-6 lg:col-span-4 xl:col-span-3">
              <%= render partial: "merchants/merchant_card", locals: { merchant: merchant } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @recent_gift_cards&.any? %>
      <div class="papayal-card p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="papayal-meta">Actividad reciente</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Tus últimas tarjetas</h2>
          </div>
          <%= link_to "Ver billetera", gift_cards_path, class: "papayal-btn-ghost text-sm" %>
        </div>
        <div class="grid grid-cols-12 gap-4">
          <% @recent_gift_cards.each do |gift_card| %>
            <div class="col-span-12 md:col-span-6 xl:col-span-4 papayal-card papayal-card-hover border border-black/5 p-5">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <p class="text-sm text-[#2C3A43]/70">De <%= gift_card.sender.name %></p>
                  <p class="text-2xl font-bold text-[#0D2F32]">
                    <%= number_to_currency(gift_card.amount / 100.0, unit: gift_card.currency == 'USD' ? '$' : gift_card.currency) %>
                  </p>
                </div>
                <span class="<%= status_badge_classes(gift_card.status) %>"><%= status_badge_label(gift_card.status) %></span>
              </div>
              <p class="text-sm text-[#2C3A43]/70">
                Disponible en <%= gift_card.merchant&.store_name || "Cualquier comercio Papayal" %>
              </p>
              <p class="text-xs text-[#2C3A43]/60 mt-2">
                Recibida el <%= gift_card.created_at.strftime('%d %b %Y') %>
              </p>
              <div class="mt-4 flex justify-end">
                <%= link_to "Ver tarjeta", gift_card_path(gift_card), class: "papayal-btn-secondary text-sm" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% elsif @merchants.blank? || @merchants.empty? %>
      <div class="papayal-card p-8 text-center space-y-3">
        <p class="text-xl font-semibold text-[#2C3A43]">Aún no tienes tarjetas recientes</p>
        <p class="text-sm text-[#2C3A43]/70">Recibe una tarjeta o cómprala desde la app móvil Papayal para ver tu actividad aquí.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <%= link_to "Explorar billetera", gift_cards_path, class: "papayal-btn-secondary" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="grid grid-cols-12 gap-6 items-center">
    <div class="col-span-12 lg:col-span-7">
      <p class="papayal-meta text-[#0D2F32]">Papayal para todos</p>
      <h1 class="text-4xl lg:text-5xl font-bold text-[#0D2F32] mt-4 leading-relaxed">
        Tarjetas de regalo cálidas con calidad fintech.
      </h1>
      <p class="text-lg text-[#2C3A43]/80 mt-4 max-w-2xl">
        Compra, envía y canjea tarjetas Papayal con la misma confianza de bancos modernos.
        Todo en español, todo seguro.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <%= link_to "Comenzar gratis", new_user_registration_path, class: "papayal-btn-primary px-6 py-3 text-base" %>
        <%= link_to "Iniciar Sesión", new_user_session_path, class: "papayal-btn-secondary px-6 py-3 text-base" %>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-5 papayal-card p-6 bg-white/80">
      <p class="papayal-meta text-[#0D2F32]">Seguridad de primer nivel</p>
      <p class="text-2xl font-bold text-[#0D2F32] mt-2">Código dinámico cada 90s</p>
      <p class="text-sm text-[#2C3A43]/70 mt-3">
        Mostramos QR, código de barras y token manual en un solo módulo elegante para proteger tus regalos.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 text-center">
        <div class="rounded-2xl border border-black/5 py-4">
          <p class="text-3xl font-bold text-[#0D2F32]">90s</p>
          <p class="text-xs text-[#2C3A43]/70 mt-1">Tiempo de vida</p>
        </div>
        <div class="rounded-2xl border border-black/5 py-4">
          <p class="text-3xl font-bold text-[#0D2F32]">3</p>
          <p class="text-xs text-[#2C3A43]/70 mt-1">Formatos seguros</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-12 grid grid-cols-12 gap-6">
    <% [
      { title: "Para personas", body: "Envía sorpresas digitales al instante con mensajes cálidos.", icon: "🎁" },
      { title: "Para comercios", body: "Recibe canjes confiables con panel profesional y reportes.", icon: "🏪" },
      { title: "Para administradores", body: "Supervisa pagos, usuarios y comercios con métricas claras.", icon: "🛡️" }
    ].each do |feature| %>
      <div class="col-span-12 md:col-span-4 papayal-card papayal-card-hover p-6">
        <div class="h-12 w-12 rounded-2xl bg-[#FCA50F]/20 flex items-center justify-center text-2xl">
          <%= feature[:icon] %>
        </div>
        <h3 class="text-xl font-bold text-[#2C3A43] mt-4"><%= feature[:title] %></h3>
        <p class="text-sm text-[#2C3A43]/80 mt-2"><%= feature[:body] %></p>
      </div>
    <% end %>
  </div>
<% end %>
