<% content_for :preview_title, "Tu cuenta de Papayal ha sido eliminada" %>
<% content_for :preheader do %>Confirmamos que tu cuenta de Papayal fue eliminada permanentemente.<% end %>

<!-- Eyebrow -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Cuenta eliminada
</div>

<h1 style="margin:0 0 18px 0; font-size:28px; line-height:1.2; font-weight:800; letter-spacing:-0.8px; color:#0D2F32;">
  Tu cuenta ha sido eliminada
</h1>

<p style="margin:0 0 18px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Hola,
</p>

<p style="margin:0 0 20px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Confirmamos que tu cuenta de Papayal ha sido eliminada permanentemente.
</p>

<!-- Summary -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="padding:18px 20px; background-color:#FDF1E1; border:1px solid #F1E2CB; border-radius:14px; font-size:15px; line-height:1.6; color:#2C3A43;">
      <strong style="color:#0D2F32;">Lo que hicimos:</strong>
      <ul style="margin:10px 0 0 0; padding-left:20px;">
        <li style="margin-bottom:6px;">Eliminamos tu información personal: nombre, teléfono, dirección, documento de identidad y foto de perfil.</li>
        <li style="margin-bottom:6px;">Cerramos todas tus sesiones activas en todos los dispositivos.</li>
        <li style="margin-bottom:6px;">Desactivamos las notificaciones para tu cuenta.</li>
        <li>Tu historial de tarjetas de regalo se anonimizó y se conserva solo para registros contables de comercios.</li>
      </ul>
    </td>
  </tr>
</table>

<!-- Warning -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="padding:16px 18px; background-color:#FDF1E1; border:1px solid #F1E2CB; border-radius:12px; font-size:14px; line-height:1.65; color:#2C3A43;">
      <strong style="color:#0D2F32;">⚠️ Importante</strong><br>
      Esta acción es permanente. No podemos restaurar tu cuenta ni los saldos de tarjetas no utilizados.
      Si esto no fue solicitado por ti, contáctanos inmediatamente en
      <a href="mailto:<%= @support_email %>" style="color:#E08A00; font-weight:600; text-decoration:none;"><%= @support_email %></a>.
    </td>
  </tr>
</table>

<p style="margin:0 0 4px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Si decides volver, puedes crear una nueva cuenta en cualquier momento con el mismo correo electrónico.
</p>
