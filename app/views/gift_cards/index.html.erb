<div class="space-y-8">
  <!-- Header Section -->
  <div class="grid grid-cols-12 gap-6 items-start">
    <div class="col-span-12 lg:col-span-8">
      <p class="papayal-meta text-[#0D2F32]">Billetera</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">Mi Billetera</h1>
      <p class="text-sm text-[#2C3A43]/80 mt-2">Administra tus tarjetas con una vista clara.</p>
    </div>
    <div class="col-span-12 lg:col-span-4 flex flex-wrap gap-3 justify-start lg:justify-end">
      <%= link_to "Actualizar Perfil", edit_user_registration_path, class: "papayal-btn-secondary" %>
      <%= link_to "Comprar Nueva Tarjeta", new_gift_card_path, class: "papayal-btn-primary" %>
    </div>
  </div>

  <!-- Summary Statistics -->
  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta">Tarjetas Enviadas</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2" id="sent-summary-count">0</p>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Regalos compartidos</p>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta">Tarjetas Recibidas</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2" id="received-summary-count">0</p>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Llegaron a ti</p>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta">Tarjetas Canjeadas</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2" id="redeemed-summary-count">0</p>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Ya utilizadas</p>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta">Valor Total</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2" id="total-value">$0.00</p>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Suma emitida</p>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="papayal-card p-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex-1">
      <label for="search-input" class="papayal-meta text-[#2C3A43]/60 mb-2 block">Buscar</label>
      <input type="text" id="search-input" placeholder="Nombre, tienda, monto o estado..." class="papayal-input">
    </div>
    <div class="flex flex-col sm:flex-row gap-4">
      <div>
        <label for="status-filter" class="papayal-meta text-[#2C3A43]/60 mb-2 block">Estado</label>
        <select id="status-filter" class="papayal-input">
          <option value="">Todos los estados</option>
          <option value="active">Activa</option>
          <option value="redeemed">Canjeada</option>
          <option value="expired">Vencida</option>
          <option value="canceled">Cancelada</option>
        </select>
      </div>
      <div>
        <label for="sort-filter" class="papayal-meta text-[#2C3A43]/60 mb-2 block">Ordenar</label>
        <select id="sort-filter" class="papayal-input">
          <option value="newest">Más recientes</option>
          <option value="oldest">Más antiguas</option>
          <option value="amount-high">Monto (Mayor a Menor)</option>
          <option value="amount-low">Monto (Menor a Mayor)</option>
          <option value="status">Estado</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Tab Navigation & Content -->
  <div class="papayal-card p-6">
    <div class="flex flex-wrap gap-3 mb-6" aria-label="Tabs">
      <button onclick="showTab('sent')" id="sent-tab" class="tab-button active-tab inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-sm font-medium border border-[#0D2F32] text-white bg-[#0D2F32] shadow-sm transition">
        <span class="text-base">📤</span> Enviadas
        <span id="sent-count" class="text-xs px-2 py-1 rounded-full bg-white/20 text-white">0</span>
      </button>
      <button onclick="showTab('received')" id="received-tab" class="tab-button inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-sm font-medium border border-transparent text-[#2C3A43]/70 bg-[#EBEBEB] hover:border-[#0D2F32]/20 transition">
        <span class="text-base">📥</span> Recibidas
        <span id="received-count" class="text-xs px-2 py-1 rounded-full bg-white text-[#0D2F32]">0</span>
      </button>
      <button onclick="showTab('redeemed')" id="redeemed-tab" class="tab-button inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-sm font-medium border border-transparent text-[#2C3A43]/70 bg-[#EBEBEB] hover:border-[#0D2F32]/20 transition">
        <span class="text-base">✅</span> Canjeadas
        <span id="redeemed-count" class="text-xs px-2 py-1 rounded-full bg-white text-[#0D2F32]">0</span>
      </button>
    </div>

    <div id="tab-content">
      <!-- Sent Cards Tab -->
      <div id="sent-content" class="tab-content">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-[#2C3A43]">Tarjetas que has enviado</h2>
          <p class="text-sm text-[#2C3A43]/70">Regalos digitales que compartiste con tus contactos.</p>
        </div>
        <div id="sent-cards" class="grid grid-cols-12 gap-6"></div>
        <div id="sent-empty" class="hidden papayal-card text-center py-12 mt-4 space-y-3">
          <p class="text-xl font-semibold text-[#2C3A43]">Aún no has enviado tarjetas</p>
          <p class="text-sm text-[#2C3A43]/70">Sorprende a alguien con una tarjeta Papayal.</p>
          <%= link_to "Enviar Tarjeta", new_gift_card_path, class: "papayal-btn-primary" %>
        </div>
      </div>

      <!-- Received Cards Tab -->
      <div id="received-content" class="tab-content hidden">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-[#2C3A43]">Tarjetas recibidas</h2>
          <p class="text-sm text-[#2C3A43]/70">Todo lo que te han enviado amigos, familia o marcas.</p>
        </div>
        <div id="received-cards" class="grid grid-cols-12 gap-6"></div>
        <div id="received-empty" class="hidden papayal-card text-center py-12 mt-4 space-y-3">
          <p class="text-xl font-semibold text-[#2C3A43]">Aún no tienes tarjetas recibidas</p>
          <p class="text-sm text-[#2C3A43]/70">Cuando llegue una tarjeta aparecerá aquí.</p>
        </div>
      </div>

      <!-- Redeemed Cards Tab -->
      <div id="redeemed-content" class="tab-content hidden">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-[#2C3A43]">Tarjetas canjeadas</h2>
          <p class="text-sm text-[#2C3A43]/70">Historial completo de tus usos.</p>
        </div>
        <div id="redeemed-cards" class="grid grid-cols-12 gap-6"></div>
        <div id="redeemed-empty" class="hidden papayal-card text-center py-12 mt-4 space-y-3">
          <p class="text-xl font-semibold text-[#2C3A43]">Sin canjes todavía</p>
          <p class="text-sm text-[#2C3A43]/70">Cuando uses una tarjeta verás los detalles aquí.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for tab functionality -->
<script>
  // Tab switching functionality
  function showTab(tabName) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(content => {
      content.classList.add('hidden');
    });
    
    // Remove active class from all tabs
    document.querySelectorAll('.tab-button').forEach(button => {
      button.classList.remove('active');
      button.style.borderColor = 'transparent';
      button.style.color = '#6B7280';
    });
    
    // Show selected tab content
    document.getElementById(tabName + '-content').classList.remove('hidden');
    
    // Add active class to selected tab
    const activeTab = document.getElementById(tabName + '-tab');
    activeTab.classList.add('active');
    activeTab.style.borderColor = '#FCA50F';
    activeTab.style.color = '#FCA50F';
  }

  // Global variables for filtering
  let allCards = [];
  let currentUserId = 0;
  let currentTab = new URLSearchParams(window.location.search).get('tab') || 'sent';
  let filteredCards = {
    sent: [],
    received: [],
    redeemed: []
  };

  // Card categorization and rendering (data loaded via fetch to reduce initial payload)
  function categorizeCards() {
    currentUserId = <%= current_user.id %>;

    const sentCards = allCards.filter(card => card.sender_id === currentUserId);
    const receivedCards = allCards.filter(card => card.recipient_id === currentUserId);
    const redeemedCards = allCards.filter(card => card.status === 'redeemed');
    
    // Store filtered cards
    filteredCards.sent = sentCards;
    filteredCards.received = receivedCards;
    filteredCards.redeemed = redeemedCards;
    
    // Update summary statistics
    updateSummaryStats(sentCards, receivedCards, redeemedCards);
    
    // Apply current filters (this will render cards and set empty states)
    applyFilters();
    
    // Explicitly set empty states after filters are applied to ensure they're correct
    toggleEmptyState('sent-empty', sentCards.length === 0);
    toggleEmptyState('received-empty', receivedCards.length === 0);
    toggleEmptyState('redeemed-empty', redeemedCards.length === 0);
  }

  function updateSummaryStats(sentCards, receivedCards, redeemedCards) {
    // Update counts
    document.getElementById('sent-count').textContent = sentCards.length;
    document.getElementById('received-count').textContent = receivedCards.length;
    document.getElementById('redeemed-count').textContent = redeemedCards.length;
    
    // Update summary counts
    document.getElementById('sent-summary-count').textContent = sentCards.length;
    document.getElementById('received-summary-count').textContent = receivedCards.length;
    document.getElementById('redeemed-summary-count').textContent = redeemedCards.length;
    
    // Calculate total value
    const totalValue = allCards.reduce((sum, card) => sum + (card.amount / 100), 0);
    document.getElementById('total-value').textContent = '$' + totalValue.toFixed(2);
  }

  function applyFilters() {
    const searchTerm = document.getElementById('search-input').value.toLowerCase();
    const statusFilter = document.getElementById('status-filter').value;
    const sortFilter = document.getElementById('sort-filter').value;
    
    // Filter and sort each category
    ['sent', 'received', 'redeemed'].forEach(category => {
      let cards = filteredCards[category];
      
      // Apply search filter
      if (searchTerm) {
        cards = cards.filter(card => {
          const senderName = card.sender ? card.sender.name.toLowerCase() : '';
          const recipientName = card.recipient ? card.recipient.name.toLowerCase() : '';
          const merchantName = card.merchant ? card.merchant.store_name.toLowerCase() : '';
          const amount = (card.amount / 100).toString();
          
          return senderName.includes(searchTerm) || 
                 recipientName.includes(searchTerm) || 
                 merchantName.includes(searchTerm) ||
                 amount.includes(searchTerm);
        });
      }
      
      // Apply status filter
      if (statusFilter) {
        cards = cards.filter(card => card.status === statusFilter);
      }
      
      // Apply sorting
      cards = sortCards(cards, sortFilter);
      
      // Render cards
      renderCards(category + '-cards', cards, category);
      
      // Show/hide empty states - only show if category has NO cards at all
      // Check the original category array, not filtered results
      const hasCardsInCategory = filteredCards[category] && filteredCards[category].length > 0;
      const cardsContainer = document.getElementById(category + '-cards');
      const hasRenderedCards = cardsContainer && cardsContainer.children.length > 0;
      
      // Hide empty state if category has cards OR if cards are rendered
      // Only show empty state if category truly has no cards
      const shouldShowEmpty = !hasCardsInCategory;
      toggleEmptyState(category + '-empty', shouldShowEmpty);
    });
  }

  function sortCards(cards, sortType) {
    switch(sortType) {
      case 'newest':
        return cards.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
      case 'oldest':
        return cards.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
      case 'amount-high':
        return cards.sort((a, b) => b.amount - a.amount);
      case 'amount-low':
        return cards.sort((a, b) => a.amount - b.amount);
      case 'status':
        return cards.sort((a, b) => a.status.localeCompare(b.status));
      default:
        return cards;
    }
  }

  function renderCards(containerId, cards, type) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    container.innerHTML = '';
    
    cards.forEach(card => {
      const cardElement = createCardElement(card, type);
      container.appendChild(cardElement);
    });
  }

  function createCardElement(card, type) {
    const div = document.createElement('div');
    div.className = 'bg-white overflow-hidden shadow-lg rounded-xl border border-gray-200 hover:shadow-xl transition-shadow duration-200';
    
    const statusColors = {
      'active': 'bg-green-100 text-green-800',
      'redeemed': 'bg-blue-100 text-blue-800',
      'expired': 'bg-red-100 text-red-800',
      'canceled': 'bg-gray-100 text-gray-800'
    };
    
    const statusIcons = {
      'active': '<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>',
      'redeemed': '<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>',
      'expired': '<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>',
      'canceled': '<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>'
    };
    
    const amount = (card.amount / 100).toFixed(2);
    const remainingBalance = (card.remaining_balance / 100).toFixed(2);
    const currency = card.currency === 'USD' ? '$' : card.currency;
    
    const statusLabels = {
      'active': 'Activa',
      'redeemed': 'Canjeada',
      'expired': 'Vencida',
      'canceled': 'Cancelada'
    };
    
    let recipientInfo = '';
    if (type === 'sent') {
      recipientInfo = `Para: ${card.recipient ? card.recipient.name : 'Desconocido'}`;
    } else if (type === 'received') {
      recipientInfo = `De: ${card.sender.name}`;
    } else {
      recipientInfo = card.sender_id === <%= current_user.id %> ? 
        `Para: ${card.recipient ? card.recipient.name : 'Desconocido'}` : 
        `De: ${card.sender.name}`;
    }
    
    div.innerHTML = `
      <div class="px-6 py-6">
        <!-- Header with amount and status -->
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center">
            <div class="w-12 h-12 ${type === 'sent' ? 'bg-blue-500' : type === 'received' ? 'bg-green-500' : 'bg-purple-500'} rounded-full flex items-center justify-center">
              <span class="text-white font-bold text-lg">${type === 'sent' ? '📤' : type === 'received' ? '📥' : '✅'}</span>
            </div>
            <div class="ml-4">
              <div class="text-2xl font-bold" style="color: #2C3A43;">${currency}${amount}</div>
              <div class="text-sm text-gray-500">${card.currency}</div>
              ${card.remaining_balance < card.amount ? `<div class="text-sm text-green-600 font-medium">Restante: ${currency}${remainingBalance}</div>` : ''}
            </div>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium ${statusColors[card.status]}">
            ${statusIcons[card.status]}
            ${statusLabels[card.status] || card.status.charAt(0).toUpperCase() + card.status.slice(1)}
          </span>
        </div>
        
        <!-- Recipient/From info -->
        <div class="mb-4">
          <div class="text-sm text-gray-600">${recipientInfo}</div>
          ${card.merchant ? `<div class="text-sm text-gray-500 mt-1">${card.status === 'redeemed' ? 'Canjeada en: ' : 'Tienda: '}${card.merchant.store_name}</div>` : ''}
        </div>
        
        <!-- Dates -->
        <div class="space-y- text-sm text-gray-500">
          ${card.redeemed_at ? `<div>Canjeada: ${new Date(card.redeemed_at).toLocaleDateString('es-EC')}</div>` : ''}
          <%# Expiration removed - gift cards never expire %>
          <div>Creada: ${new Date(card.created_at).toLocaleDateString('es-EC')}</div>
        </div>
        
        <!-- Action button -->
        <div class="mt-6">
          <a href="/gift_cards/${card.id}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2" style="color: #FCA50F; background-color: #FEF3E2;">
            Ver Detalles
            <svg class="ml-2 -mr-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>
    `;
    
    return div;
  }

  function toggleEmptyState(emptyId, isEmpty) {
    const emptyElement = document.getElementById(emptyId);
    if (!emptyElement) {
      console.warn('Empty state element not found:', emptyId);
      return;
    }
    
    // Force hide/show - ensure empty state is properly managed
    if (isEmpty) {
      emptyElement.classList.remove('hidden');
      emptyElement.style.display = '';
    } else {
      emptyElement.classList.add('hidden');
      emptyElement.style.display = 'none';
    }
  }

  // Load wallet data from JSON endpoint (reduces initial HTML payload and parse cost)
  function loadWalletData() {
    fetch('<%= gift_cards_path(format: :json) %>', {
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(res => res.ok ? res.json() : Promise.reject(new Error('Failed to load wallet')))
      .then(data => {
        allCards = Array.isArray(data) ? data : [];
        categorizeCards();
      })
      .catch(err => {
        console.error('Wallet load error:', err);
        document.querySelectorAll('[id$="-empty"]').forEach(el => { el.classList.remove('hidden'); el.style.display = ''; });
      });
  }

  // Initialize function
  function initializeWallet() {
    showTab(currentTab);
    loadWalletData();

    // Add event listeners for search and filtering
    const searchInput = document.getElementById('search-input');
    const statusFilter = document.getElementById('status-filter');
    const sortFilter = document.getElementById('sort-filter');
    
    if (searchInput) {
      if (!searchInput.dataset.walletBound) {
        searchInput.addEventListener('input', applyFilters);
        searchInput.dataset.walletBound = '1';
      }
    }
    if (statusFilter) {
      if (!statusFilter.dataset.walletBound) {
        statusFilter.addEventListener('change', applyFilters);
        statusFilter.dataset.walletBound = '1';
      }
    }
    if (sortFilter) {
      if (!sortFilter.dataset.walletBound) {
        sortFilter.addEventListener('change', applyFilters);
        sortFilter.dataset.walletBound = '1';
      }
    }
  }

  // Initialize on Turbo navigation (includes first load)
  document.addEventListener('turbo:load', initializeWallet);
</script>

<style>
  .tab-button.active {
    border-color: #FCA50F;
    color: #FCA50F;
  }
  
  .tab-button:hover {
    color: #374151;
    border-color: #D1D5DB;
  }
</style>
