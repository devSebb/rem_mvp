<div class="max-w-3xl mx-auto space-y-6">
  <div class="papayal-card p-8">
    <div class="mb-6">
      <p class="papayal-meta text-[#0D2F32]">Nueva tarjeta</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">Comprar Tarjeta de Regalo</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Completa los datos en español. El formulario valida teléfono y correo.</p>
    </div>

    <%= form_with url: checkout_gift_cards_path, method: :post, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :amount_cents, "Monto", class: "papayal-label" %>
        <div class="mt-2 relative">
          <span class="absolute inset-y-0 left-3 flex items-center text-[#2C3A43]/50">$</span>
          <%= form.number_field :amount_cents,
                value: params[:amount_cents],
                min: 1,
                step: 0.01,
                inputmode: "decimal",
                class: "papayal-input pl-8",
                placeholder: "50.00" %>
        </div>
        <p class="mt-1 text-xs text-[#2C3A43]/60">Monto mínimo $1.00 USD.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :currency, "Moneda", class: "papayal-label" %>
          <%= form.select :currency,
                options_for_select([['USD', 'USD'], ['EUR', 'EUR']], params[:currency] || 'USD'),
                {},
                class: "papayal-input mt-2" %>
        </div>
        <div>
          <%= form.label :merchant_id, "Tienda", class: "papayal-label" %>
          <%= form.select :merchant_id,
                options_for_select(Merchant.all.map { |m| [m.store_name, m.id] }, params[:merchant_id]),
                class: "papayal-input mt-2",
                required: true %>
        </div>
      </div>

      <div>
        <%= form.label :recipient_name, "Nombre del destinatario", class: "papayal-label" %>
        <%= form.text_field :recipient_name,
              value: params[:recipient_name],
              class: "papayal-input mt-2",
              placeholder: "Andrea Morales" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :recipient_phone, "Teléfono del destinatario", class: "papayal-label" %>
          <%= form.telephone_field :recipient_phone,
                value: params[:recipient_phone],
                class: "papayal-input mt-2",
                placeholder: "+593 99 999 9999" %>
          <p class="mt-1 text-xs text-[#2C3A43]/60">Debe incluir código de país.</p>
        </div>
        <div>
          <%= form.label :recipient_email, "Correo del destinatario", class: "papayal-label" %>
          <%= form.email_field :recipient_email,
                value: params[:recipient_email],
                class: "papayal-input mt-2",
                placeholder: "destinatario@ejemplo.com" %>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4">
        <%= link_to "Cancelar", root_path, class: "papayal-btn-secondary w-full text-center" %>
        <%= form.submit "Continuar al pago", class: "papayal-btn-primary w-full" %>
      </div>
    <% end %>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
  const stripe = Stripe("<%= ENV['STRIPE_PUBLISHABLE_KEY'] %>");
</script>
