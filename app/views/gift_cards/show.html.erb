<div class="space-y-8">
  <div class="flex items-center">
    <% back_target = request.referer.presence || gift_cards_path(tab: params[:tab].presence || 'sent') %>
    <%= link_to back_target, class: "inline-flex items-center gap-2 text-sm text-[#0D2F32] hover:text-[#0B2528]" do %>
      <span aria-hidden="true">←</span>
      <span>Volver</span>
    <% end %>
  </div>

  <div class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="papayal-meta text-[#0D2F32]">Tarjeta Papayal</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">Detalles de la Tarjeta de Regalo</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Visualiza toda la información clave antes de compartir o canjear.</p>
    </div>
    <span class="<%= status_badge_classes(@gift_card.status) %>"><%= status_badge_label(@gift_card.status) %></span>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8 space-y-6">
      <div class="papayal-card p-6">
        <h2 class="text-xl font-bold text-[#2C3A43] mb-4">Resumen</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-[#2C3A43]/80">
          <div>
            <dt class="papayal-meta text-[#2C3A43]/60">Monto total</dt>
            <dd class="text-2xl font-bold text-[#0D2F32] mt-1">
              <%= number_to_currency(@gift_card.amount / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
            </dd>
          </div>
          <div>
            <dt class="papayal-meta text-[#2C3A43]/60">Saldo restante</dt>
            <dd class="text-2xl font-bold text-[#0D2F32] mt-1">
              <%= number_to_currency(@gift_card.remaining_balance / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
            </dd>
          </div>
          <div>
            <dt class="papayal-meta text-[#2C3A43]/60">De</dt>
            <dd class="text-base text-[#2C3A43] mt-1"><%= @gift_card.sender.name %></dd>
          </div>
          <div>
            <dt class="papayal-meta text-[#2C3A43]/60">Para</dt>
            <dd class="text-base text-[#2C3A43] mt-1"><%= @gift_card.recipient&.name || 'Desconocido' %></dd>
          </div>
          <% if @gift_card.merchant.present? %>
            <div>
              <dt class="papayal-meta text-[#2C3A43]/60">Tienda asociada</dt>
              <dd class="text-base text-[#2C3A43] mt-1"><%= @gift_card.merchant.store_name %></dd>
            </div>
          <% end %>
          <% if @gift_card.expires_at.present? %>
            <div>
              <dt class="papayal-meta text-[#2C3A43]/60">Vence</dt>
              <dd class="text-base text-[#2C3A43] mt-1"><%= @gift_card.expires_at.strftime('%d/%m/%Y %H:%M') %></dd>
            </div>
          <% end %>
          <% if @gift_card.redeemed_at.present? %>
            <div>
              <dt class="papayal-meta text-[#2C3A43]/60">Canjeada</dt>
              <dd class="text-base text-[#2C3A43] mt-1">
                <%= @gift_card.redeemed_at.strftime('%d/%m/%Y %H:%M') %>
                <% if @gift_card.merchant.present? %>
                  <span class="block text-xs text-[#2C3A43]/60">en <%= @gift_card.merchant.store_name %></span>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>

        <% if policy(@gift_card).view_code? %>
          <div class="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50/60 p-4">
            <p class="papayal-meta text-emerald-700">Token dinámico</p>
            <p class="text-sm text-emerald-900 mt-2">
              El panel de códigos muestra QR, código de barras o token manual. Todo se actualiza cada 90 segundos para máxima seguridad.
            </p>
          </div>
        <% elsif @gift_card.sender == current_user %>
          <div class="mt-6 rounded-2xl border border-blue-100 bg-blue-50/70 p-4">
            <p class="papayal-meta text-blue-800">Código oculto por seguridad</p>
            <p class="text-base font-mono tracking-widest text-blue-900 mt-2">
              <%= @gift_card.raw_code&.gsub(/(REM-)(.{4})(.{4})(.{4})/, '\1****-****-\3') || 'REM-****-****-****' %>
            </p>
            <p class="text-xs text-blue-800 mt-1">Solo el destinatario puede ver el código completo.</p>
          </div>
        <% end %>
      </div>

      <div class="papayal-card p-6">
        <h2 class="text-xl font-bold text-[#2C3A43] mb-4">Línea de tiempo</h2>
        <div class="space-y-4 text-sm text-[#2C3A43]/80">
          <div class="flex items-center gap-3">
            <span class="h-10 w-10 rounded-2xl bg-[#FCA50F]/20 flex items-center justify-center text-[#0D2F32] font-semibold">1</span>
            <div>
              <p class="font-medium text-[#2C3A43]">Creada</p>
              <p><%= @gift_card.created_at.strftime('%d/%m/%Y %H:%M') %></p>
            </div>
          </div>
          <% if @gift_card.redeemed_at.present? %>
            <div class="flex items-center gap-3">
              <span class="h-10 w-10 rounded-2xl bg-emerald-100 flex items-center justify-center text-emerald-800 font-semibold">2</span>
              <div>
                <p class="font-medium text-[#2C3A43]">Canjeada</p>
                <p><%= @gift_card.redeemed_at.strftime('%d/%m/%Y %H:%M') %></p>
              </div>
            </div>
          <% end %>
          <% if @gift_card.expires_at.present? %>
            <div class="flex items-center gap-3">
              <span class="h-10 w-10 rounded-2xl bg-[#0D2F32]/10 flex items-center justify-center text-[#0D2F32] font-semibold">∞</span>
              <div>
                <p class="font-medium text-[#2C3A43]">Expira</p>
                <p><%= @gift_card.expires_at.strftime('%d/%m/%Y %H:%M') %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-span-12 lg:col-span-4 space-y-6">
      <div class="papayal-card p-6 space-y-4">
        <div>
          <p class="papayal-meta text-[#2C3A43]/60">Saldo disponible</p>
          <p class="text-4xl font-bold text-[#0D2F32] mt-2">
            <%= number_to_currency(@gift_card.remaining_balance / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
          </p>
          <p class="text-sm text-[#2C3A43]/70 mt-1">Actualizado en tiempo real</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Volver a la Billetera", gift_cards_path, class: "papayal-btn-secondary w-full" %>
          <% if policy(@gift_card).transfer? %>
            <%= link_to "Transferir", new_gift_card_transfer_path(@gift_card), class: "papayal-btn-primary w-full" %>
          <% end %>
          <% if policy(@gift_card).refund? && @gift_card.transactions.successful.redemptions.any? %>
            <%= link_to "Emitir Reembolso", new_admin_gift_card_refund_path(@gift_card), class: "papayal-btn-ghost w-full text-center border border-rose-200 text-rose-700 bg-rose-50/60 hover:bg-rose-100" %>
          <% end %>
          <% if @gift_card.active? %>
            <%= link_to "Comprar Otra", new_gift_card_path, class: "papayal-btn-ghost w-full text-center" %>
          <% end %>
        </div>
      </div>

      <% if @gift_card.active? && policy(@gift_card).view_code? %>
        <div class="papayal-card p-6 bg-[#EBEBEB]/60"
             data-controller="redemption-code"
             data-redemption-code-url-value="<%= api_v1_gift_card_redemption_token_path(@gift_card) %>">
          <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
            <div>
              <p class="papayal-meta text-[#0D2F32]">Panel de canje</p>
              <h3 class="text-xl font-bold text-[#0D2F32] mt-1">Tu código Papayal</h3>
            </div>
            <div class="flex items-center gap-2 text-sm text-[#2C3A43]/70">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span data-redemption-code-target="timer">--s</span>
            </div>
          </div>
          <p class="text-sm text-[#2C3A43]/70 mb-4">
            Escanea, comparte o escribe este token. Se renueva automáticamente para mantener tu seguridad.
          </p>
          <div data-redemption-code-target="status" class="hidden text-sm text-amber-800 bg-amber-50 border border-amber-100 rounded-xl px-3 py-2 mb-4"></div>
          <div class="flex flex-col gap-6">
            <div class="flex flex-col items-center">
              <canvas width="220" height="220" class="bg-white rounded-2xl shadow-inner p-2" data-redemption-code-target="qr"></canvas>
              <p class="text-xs text-[#2C3A43]/60 mt-2">Código QR (TTL 90s)</p>
            </div>
            <div class="flex flex-col gap-3">
              <div class="flex flex-col sm:flex-row items-center gap-3">
                <span id="manual-token" class="font-mono tracking-[0.35em] text-lg bg-black/5 rounded-lg px-3 py-2 text-[#0D2F32]" data-redemption-code-target="code">••••</span>
                <button type="button" class="papayal-btn-secondary text-sm w-full sm:w-auto justify-center" data-copy-target="manual-token">
                  Copiar código
                </button>
              </div>
              <p class="text-xs text-[#2C3A43]/60 text-center sm:text-left">Entrega este código si el comercio no puede escanear.</p>
            </div>
            <div class="border border-black/5 rounded-2xl bg-white p-4">
              <svg class="w-full h-20" data-redemption-code-target="barcode"></svg>
            </div>
          </div>
        </div>
      <% elsif @gift_card.active? && @gift_card.sender == current_user %>
        <div class="papayal-card p-6 text-center">
          <p class="papayal-meta text-[#2C3A43]/60">Código seguro</p>
          <h3 class="text-xl font-bold text-[#2C3A43] mt-2">Solo visible para el destinatario</h3>
          <p class="text-sm text-[#2C3A43]/70 mt-2">Compartimos el código real únicamente con la persona que recibirá la tarjeta.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-copy-target]');
    if (!button) return;

    event.preventDefault();
    const targetId = button.getAttribute('data-copy-target');
    const tokenElement = document.getElementById(targetId);
    if (!tokenElement) return;

    const text = tokenElement.textContent.trim();
    if (!text || text.includes('•')) return;

    navigator.clipboard.writeText(text).then(() => {
      button.dataset.originalText = button.dataset.originalText || button.textContent;
      button.textContent = 'Copiado ✓';
      setTimeout(() => button.textContent = button.dataset.originalText, 2000);
    });
  });
</script>

</div>

