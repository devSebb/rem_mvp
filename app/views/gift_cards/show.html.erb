<div class="max-w-2xl mx-auto">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="px-6 py-8">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Detalles de la Tarjeta de Regalo</h1>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= 
          case @gift_card.status
          when 'active'
            'bg-green-100 text-green-800'
          when 'redeemed'
            'bg-blue-100 text-blue-800'
          when 'expired'
            'bg-red-100 text-red-800'
          when 'canceled'
            'bg-gray-100 text-gray-800'
          else
            'bg-gray-100 text-gray-800'
          end
        %>">
          <% if @gift_card.status == 'active' %>
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
          <% elsif @gift_card.status == 'redeemed' %>
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          <% elsif @gift_card.status == 'expired' %>
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
            </svg>
          <% elsif @gift_card.status == 'canceled' %>
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
            </svg>
          <% end %>
          <% case @gift_card.status
             when 'active'
               'Activa'
             when 'redeemed'
               'Canjeada'
             when 'expired'
               'Vencida'
             when 'canceled'
               'Cancelada'
             else
               @gift_card.status.humanize
             end %>
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-4">Información de la Tarjeta</h3>
          
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-500">Monto</dt>
              <dd class="text-2xl font-bold text-gray-900">
                <%= number_to_currency(@gift_card.amount / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
              </dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">De</dt>
              <dd class="text-sm text-gray-900"><%= @gift_card.sender.name %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Para</dt>
              <dd class="text-sm text-gray-900"><%= @gift_card.recipient&.name || 'Desconocido' %></dd>
            </div>
            
            <% if @gift_card.merchant.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Tienda</dt>
                <dd class="text-sm text-gray-900"><%= @gift_card.merchant.store_name %></dd>
              </div>
            <% end %>
            
            <% if @gift_card.expires_at.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Vence</dt>
                <dd class="text-sm text-gray-900"><%= @gift_card.expires_at.strftime('%B %d, %Y a las %I:%M %p') %></dd>
              </div>
            <% end %>
            
            <% if @gift_card.redeemed_at.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Canjeada</dt>
                <dd class="text-sm text-gray-900">
                  <%= @gift_card.redeemed_at.strftime('%B %d, %Y a las %I:%M %p') %>
                  <% if @gift_card.merchant.present? %>
                    <br><span class="text-xs text-gray-500">en <%= @gift_card.merchant.store_name %></span>
                  <% end %>
                </dd>
              </div>
            <% end %>

            <!-- Gift Card Code Display -->
            <% if policy(@gift_card).view_code? %>
              <div class="bg-green-50 border border-green-200 rounded-md p-3 mt-4">
                <dt class="text-sm font-medium text-green-800">🎫 Token dinámico</dt>
                <dd class="text-sm text-green-800 mt-1">
                  Usa el panel de la derecha para mostrar tu código QR, código de barras o código manual. Cambia cada 90 segundos para tu seguridad.
                </dd>
              </div>
            <% elsif @gift_card.sender == current_user %>
              <!-- Senders can only see masked code -->
              <div class="bg-blue-50 border border-blue-200 rounded-md p-3 mt-4">
                <dt class="text-sm font-medium text-blue-800">🎁 Código de Tarjeta de Regalo</dt>
                <dd class="text-lg font-mono font-bold text-blue-900 mt-1">
                  <%= @gift_card.raw_code&.gsub(/(REM-)(.{4})(.{4})(.{4})/, '\1****-****-\3') || 'REM-****-****-****' %>
                </dd>
                <p class="text-xs text-blue-700 mt-1">
                  Solo el destinatario puede ver el código completo por seguridad.
                </p>
              </div>
            <% end %>
          </dl>
        </div>

        <% if @gift_card.active? && policy(@gift_card).view_code? %>
          <div 
            class="bg-gray-50 border border-gray-200 rounded-xl p-6"
            data-controller="redemption-code"
            data-redemption-code-url-value="<%= api_v1_gift_card_redemption_token_path(@gift_card) %>">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-medium text-gray-900">Tu código Papayal</h3>
              <div class="flex items-center text-sm text-gray-500">
                <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span data-redemption-code-target="timer">--s</span>
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-4">
              Muestra cualquiera de estas opciones al comercio. Todas apuntan al mismo token seguro y se renuevan automáticamente.
            </p>
            <div data-redemption-code-target="status" class="hidden text-sm text-yellow-800 bg-yellow-100 border border-yellow-200 rounded-md px-3 py-2 mb-4"></div>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="text-center">
                <canvas
                  width="220"
                  height="220"
                  class="mx-auto bg-white rounded-lg shadow p-2"
                  data-redemption-code-target="qr">
                </canvas>
                <p class="mt-2 text-xs text-gray-500">Escanea el QR (90s TTL)</p>
              </div>
              <div class="flex flex-col items-center justify-center space-y-4">
                <svg class="w-full h-20" data-redemption-code-target="barcode"></svg>
                <div class="text-2xl font-mono tracking-[0.3em] text-gray-900" data-redemption-code-target="code">
                  ••••
                </div>
                <p class="text-xs text-gray-500 text-center">Ingresa el código manual si no puedes escanear.</p>
              </div>
            </div>
          </div>
        <% elsif @gift_card.active? && @gift_card.sender == current_user %>
          <div class="text-center">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Código QR</h3>
            <div class="bg-gray-100 p-8 rounded-lg border-2 border-gray-300 inline-block">
              <div class="text-gray-400">
                <svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                </svg>
                <p class="text-sm text-gray-500">Código QR solo visible para el destinatario</p>
              </div>
            </div>
            <p class="mt-2 text-sm text-gray-500">Solo el destinatario puede ver el código QR</p>
          </div>
        <% end %>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row justify-between gap-4">
        <%= link_to "Volver a la Billetera", gift_cards_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline text-center" %>
        <div class="flex flex-col sm:flex-row gap-2">
          <% if policy(@gift_card).transfer? %>
            <%= link_to "Transferir", new_gift_card_transfer_path(@gift_card), class: "bg-purple-500 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline text-center" %>
          <% end %>
          <% if current_user&.admin? && @gift_card.transactions.successful.redemptions.any? %>
            <%= link_to "Emitir Reembolso", new_admin_refund_path(@gift_card), class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline text-center" %>
          <% end %>
          <% if @gift_card.active? %>
            <%= link_to "Comprar Otra", new_gift_card_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline text-center" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

