<div class="min-h-[70vh] flex items-center justify-center">
  <div class="papayal-card p-8 w-full max-w-md">
    <div class="text-center mb-6">
      <p class="papayal-meta text-[#0D2F32]">Recuperación</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">¿Olvidaste tu contraseña?</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Ingresa tu correo y te enviaremos instrucciones en español.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, class: "space-y-5") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Correo electrónico", class: "papayal-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "papayal-input mt-2", placeholder: "tu@correo.com" %>
      </div>

      <%= f.submit "Enviar instrucciones", class: "papayal-btn-primary w-full" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-[#2C3A43]/80">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
