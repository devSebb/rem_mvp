<div class="min-h-[70vh] flex items-center justify-center">
  <div class="papayal-card p-8 w-full max-w-md">
    <div class="text-center mb-6">
      <p class="papayal-meta text-[#0D2F32]">Bienvenido de vuelta</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">Iniciar sesión</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Ingresa con tu correo electrónico para continuar usando Papayal.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, class: "space-y-5") do |f| %>
      <div>
        <%= f.label :email, "Correo electrónico", class: "papayal-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "papayal-input mt-2" %>
      </div>

      <div>
        <%= f.label :password, "Contraseña", class: "papayal-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "papayal-input mt-2" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-[#2C3A43]/80">
          <%= f.check_box :remember_me, class: "rounded border-black/10 text-[#FCA50F] focus:ring-[#FCA50F]" %>
          Recordarme en este dispositivo
        </label>
      <% end %>

      <%= f.submit "Iniciar sesión", class: "papayal-btn-primary w-full" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-[#2C3A43]/80">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
