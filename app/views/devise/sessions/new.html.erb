<div class="max-w-md mx-auto">
  <div class="bg-white shadow-md rounded-lg px-8 pt-6 pb-8 mb-4">
    <h2 class="text-2xl font-bold mb-6 text-center" style="color: #2C3A43;">Iniciar Sesión</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, class: "space-y-6") do |f| %>
      <div>
        <%= f.label :email, "Correo Electrónico", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;" %>
      </div>

      <div>
        <%= f.label :password, "Contraseña", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 border-gray-300 rounded", style: "accent-color: #FCA50F;" %>
          <%= f.label :remember_me, "Recordarme", class: "ml-2 block text-sm", style: "color: #2C3A43;" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Iniciar Sesión", class: "w-full text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline", style: "background-color: #FCA50F;" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
