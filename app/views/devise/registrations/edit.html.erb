<div class="space-y-8">
  <div class="papayal-card p-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="papayal-meta text-[#0D2F32]">Perfil</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-1">Administra tu cuenta</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Actualiza tus datos personales y tu contraseña con la misma calidez del resto de Papayal.</p>
    </div>
    <div class="inline-flex items-center gap-3">
      <%= avatar_image_for(resource, size: 48, classes: "shadow-sm") %>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0D2F32]/10 text-[#0D2F32] text-sm font-medium">
        ID • <%= resource.id %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8 space-y-6">
      <div class="papayal-card p-6 space-y-6">
        <div>
          <p class="papayal-meta text-[#2C3A43]/60">Foto de perfil</p>
          <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Tu avatar</h2>
        </div>
        <div class="flex items-center gap-6">
          <div class="flex-shrink-0">
            <%= avatar_image_for(resource, size: 48, classes: "shadow-sm") %>
          </div>
          <div class="flex-1">
            <%= form_with url: registration_path(resource_name), method: :put, local: true, multipart: true, data: { turbo: false }, class: "space-y-4" do |avatar_form| %>
              <%= hidden_field_tag :avatar_only, true %>
              <label for="user_avatar" class="papayal-label">Cambiar foto de perfil</label>
              <%= file_field_tag "user[avatar]", accept: "image/*", class: "papayal-input mt-2", onchange: "previewAvatar(this)", id: "user_avatar" %>
              <p class="text-xs text-[#2C3A43]/70 mt-1">Formato: JPG, PNG o GIF. Tamaño máximo: 5MB.</p>
              <% if resource.avatar.attached? %>
                <p class="text-xs text-emerald-600 mt-1">✓ Tienes una foto de perfil</p>
              <% end %>
              <div id="avatar-preview" class="hidden mt-4 flex items-center gap-3">
                <p class="text-sm text-[#2C3A43]/70">Vista previa:</p>
                <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-[#FCA50F]">
                  <img id="avatar-preview-img" src="" alt="Preview" class="w-full h-full object-cover">
                </div>
              </div>
              <div class="mt-4">
                <%= submit_tag "Guardar foto", class: "papayal-btn-primary text-sm py-2 px-4" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, class: "space-y-8") do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="papayal-card p-6 space-y-4">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Datos personales</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Información básica</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :first_name, "Nombre", class: "papayal-label" %>
              <%= f.text_field :first_name, autofocus: true, required: true, class: "papayal-input mt-2", placeholder: "Mariana" %>
            </div>
            <div>
              <%= f.label :last_name, "Apellido", class: "papayal-label" %>
              <%= f.text_field :last_name, required: true, class: "papayal-input mt-2", placeholder: "López" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :phone, "Teléfono", class: "papayal-label" %>
              <%= f.telephone_field :phone, required: true, class: "papayal-input mt-2", placeholder: "+593 99 999 9999" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :email, "Correo electrónico", class: "papayal-label" %>
              <%= f.email_field :email, autocomplete: "email", class: "papayal-input mt-2", placeholder: "tu@correo.com" %>
              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <p class="text-xs text-[#2C3A43]/60 mt-1">Esperando confirmación para: <%= resource.unconfirmed_email %></p>
              <% end %>
            </div>
          </div>
        </div>

        <div id="kyc-section" class="papayal-card p-6 space-y-4 ">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Datos para compras</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Información requerida para checkout</h2>
            <p class="text-sm text-[#2C3A43]/70 mt-1">Estos datos son necesarios para comprar tarjetas de regalo.</p>
          </div>
          <% kyc_complete = resource.date_of_birth.present? && resource.address.present? && resource.country_of_residence.present? %>
          <% unless kyc_complete %>
            <div class="rounded-lg border border-amber-200 bg-amber-50/60 p-3 text-sm text-amber-800">
              <p class="font-medium flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                Completa estos datos para poder comprar tarjetas de regalo
              </p>
            </div>
          <% end %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :date_of_birth, "Fecha de nacimiento", class: "papayal-label" %>
              <%= f.date_field :date_of_birth, class: "papayal-input mt-2", max: Date.today - 18.years, min: Date.today - 120.years %>
              <p class="text-xs text-[#2C3A43]/60 mt-1">Debes ser mayor de 18 años.</p>
            </div>
            <div>
              <%= f.label :national_id, "Documento de identidad", class: "papayal-label" %>
              <%= f.text_field :national_id, class: "papayal-input mt-2", placeholder: "Ej: 1234567890" %>
              <p class="text-xs text-[#2C3A43]/60 mt-1">Cédula, DNI o pasaporte (mínimo 7 caracteres).</p>
            </div>
            <div>
              <%= f.label :country_of_residence, "País de residencia", class: "papayal-label" %>
              <%= f.select :country_of_residence,
                    options_for_select([
                      ['Selecciona un país', ''],
                      ['Ecuador', 'Ecuador'],
                      ['Colombia', 'Colombia'],
                      ['Perú', 'Perú'],
                      ['México', 'México'],
                      ['Argentina', 'Argentina'],
                      ['Chile', 'Chile'],
                      ['España', 'España'],
                      ['Estados Unidos', 'Estados Unidos'],
                      ['Otro', 'Otro']
                    ], resource.country_of_residence),
                    {},
                    class: "papayal-input mt-2" %>
            </div>
            <div>
              <%= f.label :address, "Dirección", class: "papayal-label" %>
              <%= f.text_field :address, class: "papayal-input mt-2", placeholder: "Av. Principal 123, Ciudad" %>
            </div>
          </div>
        </div>

        <div class="papayal-card p-6 space-y-4 mt-8">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Seguridad</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Actualizar contraseña</h2>
            <p class="text-sm text-[#2C3A43]/70 mt-1">Déjalo en blanco si no deseas cambiarla. Siempre necesitaremos tu contraseña actual para confirmar.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :password, "Nueva contraseña", class: "papayal-label" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "papayal-input mt-2" %>
              <% if @minimum_password_length %>
                <p class="text-xs text-[#2C3A43]/60 mt-1">Mínimo <%= @minimum_password_length %> caracteres.</p>
              <% end %>
            </div>
            <div>
              <%= f.label :password_confirmation, "Confirmar nueva contraseña", class: "papayal-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "papayal-input mt-2" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :current_password, "Contraseña actual", class: "papayal-label" %>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "papayal-input mt-2" %>
              <p class="text-xs text-[#2C3A43]/60 mt-1">Necesaria para confirmar cualquier cambio.</p>
            </div>
          </div>
        </div>

        <div class="pt-6">
          <div class="flex flex-col sm:flex-row gap-3">
            <%= link_to "Volver al inicio", root_path, class: "papayal-btn-secondary w-full sm:w-auto text-center py-3" %>
            <%= f.submit "Guardar cambios", class: "papayal-btn-primary w-full sm:w-auto py-3" %>
          </div>
        </div>
      <% end %>

      <div class="papayal-card p-6 border border-rose-200 bg-rose-50/60 space-y-4">
        <div>
          <p class="papayal-meta text-rose-700">Zona de riesgo</p>
          <h2 class="text-xl font-bold text-rose-800 mt-1">Cancelar mi cuenta</h2>
          <p class="text-sm text-rose-800/80 mt-1">Si ya no deseas usar Papayal puedes eliminar tu cuenta permanentemente.</p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <%= button_to "Cancelar mi cuenta", registration_path(resource_name),
                data: { confirm: "¿Seguro que deseas eliminar tu cuenta?", turbo_confirm: "¿Seguro que deseas eliminar tu cuenta?" },
                method: :delete,
                class: "papayal-btn-ghost w-full text-center border border-rose-300 text-rose-700 hover:bg-rose-100" %>
        </div>
      </div>
    </div>

    <div class="col-span-12 lg:col-span-4 space-y-6">
      <% kyc_sidebar_complete = resource.date_of_birth.present? && resource.address.present? && resource.country_of_residence.present? %>
      <div class="papayal-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Estado de verificación</p>
            <h3 class="text-xl font-bold text-[#2C3A43]">Datos para compras</h3>
          </div>
          <% if kyc_sidebar_complete %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Completo
            </span>
          <% else %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01"/>
              </svg>
              Pendiente
            </span>
          <% end %>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2">
            <% if resource.date_of_birth.present? %>
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-[#2C3A43]">Fecha de nacimiento</span>
            <% else %>
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              <span class="text-[#2C3A43]/60">Fecha de nacimiento</span>
            <% end %>
          </div>
          <div class="flex items-center gap-2">
            <% if resource.country_of_residence.present? %>
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-[#2C3A43]">País de residencia</span>
            <% else %>
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              <span class="text-[#2C3A43]/60">País de residencia</span>
            <% end %>
          </div>
          <div class="flex items-center gap-2">
            <% if resource.address.present? %>
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-[#2C3A43]">Dirección</span>
            <% else %>
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              <span class="text-[#2C3A43]/60">Dirección</span>
            <% end %>
          </div>
        </div>
        <% unless kyc_sidebar_complete %>
          <a href="#kyc-section" class="block text-center text-sm text-[#FCA50F] hover:text-[#0D2F32] font-medium">
            Completar datos abajo ↓
          </a>
        <% end %>
      </div>

      <div class="papayal-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Estado</p>
            <h3 class="text-xl font-bold text-[#2C3A43]">Tu rol en Papayal</h3>
          </div>
          <% role_badge = case resource.role
             when 'admin' then ['Admin', 'bg-[#0D2F32] text-white']
             when 'merchant' then ['Comercio', 'bg-[#FCA50F]/20 text-[#0D2F32]']
             else ['Usuario', 'bg-[#0D2F32]/10 text-[#0D2F32]']
          end %>
          <span class="inline-flex items-center px-4 py-1 rounded-full text-xs font-semibold <%= role_badge.last %>">
            <%= role_badge.first %>
          </span>
        </div>
        <div class="space-y-3 text-sm text-[#2C3A43]/80">
          <div class="flex items-center justify-between">
            <span>Nombre</span>
            <span class="font-semibold text-[#0D2F32]"><%= resource.full_name %></span>
          </div>
          <div class="flex items-center justify-between">
            <span>Email</span>
            <span class="font-semibold text-[#0D2F32] truncate max-w-[180px]" title="<%= resource.email %>"><%= resource.email %></span>
          </div>
          <% if resource.phone.present? %>
            <div class="flex items-center justify-between">
              <span>Teléfono</span>
              <span class="font-semibold text-[#0D2F32]"><%= resource.phone %></span>
            </div>
          <% end %>
          <div class="flex items-center justify-between">
            <span>Miembro desde</span>
            <span class="font-semibold text-[#0D2F32]"><%= resource.created_at.strftime("%d/%m/%Y") %></span>
          </div>
        </div>
      </div>

      <div class="papayal-card p-6 space-y-3">
        <p class="papayal-meta text-[#2C3A43]/60">Ayuda rápida</p>
        <h3 class="text-xl font-bold text-[#2C3A43]">¿Necesitas soporte?</h3>
        <p class="text-sm text-[#2C3A43]/70">Escríbenos si tienes dudas sobre tu cuenta o quieres convertirte en comercio.</p>
        <%= link_to "Contactar soporte", "mailto:soporte@papayal.com", class: "papayal-btn-secondary w-full text-center" %>
      </div>
    </div>
  </div>
</div>

<script>
  function previewAvatar(input) {
    const preview = document.getElementById('avatar-preview');
    const previewImg = document.getElementById('avatar-preview-img');
    
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      
      reader.onload = function(e) {
        previewImg.src = e.target.result;
        preview.classList.remove('hidden');
      };
      
      reader.readAsDataURL(input.files[0]);
    } else {
      preview.classList.add('hidden');
    }
  }
</script>
