<div class="min-h-[70vh] flex items-center justify-center">
  <div class="papayal-card p-8 w-full max-w-lg">
    <div class="text-center mb-6">
      <p class="papayal-meta text-[#0D2F32]">Crear cuenta</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-2">Únete a Papayal</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-2">Configura tu perfil para enviar y recibir tarjetas con total seguridad.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, class: "space-y-5") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :first_name, "Nombre", class: "papayal-label" %>
        <%= f.text_field :first_name, autofocus: true, required: true, class: "papayal-input mt-2", placeholder: "Mariana" %>
      </div>

      <div>
        <%= f.label :last_name, "Apellido", class: "papayal-label" %>
        <%= f.text_field :last_name, required: true, class: "papayal-input mt-2", placeholder: "López" %>
      </div>

      <div>
        <%= f.label :email, "Correo electrónico", class: "papayal-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "papayal-input mt-2", placeholder: "tu@correo.com" %>
      </div>

      <div>
        <%= f.label :phone, "Teléfono", class: "papayal-label" %>
        <%= f.telephone_field :phone, required: true, autocomplete: "tel", class: "papayal-input mt-2", placeholder: "+593 99 999 9999" %>
      </div>

      <div>
        <%= f.label :password, "Contraseña", class: "papayal-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "papayal-input mt-2" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-[#2C3A43]/60 mt-1">Mínimo <%= @minimum_password_length %> caracteres</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirmar contraseña", class: "papayal-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "papayal-input mt-2" %>
      </div>

      <div class="pt-2">
        <label class="flex items-start gap-3 cursor-pointer group">
          <%= f.check_box :terms_accepted, { 
            class: "mt-1 h-4 w-4 rounded border-black/20 text-[#FCA50F] focus:ring-[#FCA50F] focus:ring-2 cursor-pointer transition",
            required: true,
            id: "user_terms_accepted"
          }, "1", "0" %>
          <span class="text-sm text-[#2C3A43] leading-relaxed">
            Acepto los 
            <%= link_to "Términos y Condiciones", legal_terminos_path, target: "_blank", class: "text-[#FCA50F] hover:text-[#0D2F32] underline font-medium" %> 
            y la 
            <%= link_to "Política de Privacidad", legal_privacidad_path, target: "_blank", class: "text-[#FCA50F] hover:text-[#0D2F32] underline font-medium" %> 
            de Papayal. También acepto todos los 
            <%= link_to "documentos legales", legal_path, target: "_blank", class: "text-[#FCA50F] hover:text-[#0D2F32] underline font-medium" %>.
          </span>
        </label>
        <% if resource.errors[:terms_accepted].any? %>
          <p class="text-xs text-rose-600 mt-1"><%= resource.errors[:terms_accepted].first %></p>
        <% end %>
      </div>

      <%= f.submit "Registrarme", class: "papayal-btn-primary w-full", id: "registration-submit-btn", disabled: true %>
    <% end %>

    <div class="mt-6 text-center text-sm text-[#2C3A43]/80">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const termsCheckbox = document.getElementById('user_terms_accepted');
    const submitButton = document.getElementById('registration-submit-btn');
    
    if (termsCheckbox && submitButton) {
      // Update button state on checkbox change
      termsCheckbox.addEventListener('change', function() {
        if (this.checked) {
          submitButton.disabled = false;
          submitButton.classList.remove('opacity-50', 'cursor-not-allowed');
          submitButton.classList.add('hover:brightness-95');
        } else {
          submitButton.disabled = true;
          submitButton.classList.add('opacity-50', 'cursor-not-allowed');
          submitButton.classList.remove('hover:brightness-95');
        }
      });
      
      // Initial state check
      if (!termsCheckbox.checked) {
        submitButton.disabled = true;
        submitButton.classList.add('opacity-50', 'cursor-not-allowed');
        submitButton.classList.remove('hover:brightness-95');
      }
    }
  });
</script>
