<div class="max-w-md mx-auto">
  <div class="bg-white shadow-md rounded-lg px-8 pt-6 pb-8 mb-4">
    <h2 class="text-2xl font-bold mb-6 text-center" style="color: #2C3A43;">Registrarse</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, class: "space-y-6") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :name, "Nombre", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.text_field :name, autofocus: true, class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;" %>
      </div>

      <div>
        <%= f.label :email, "Correo Electrónico", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;" %>
      </div>

      <div>
        <%= f.label :phone, "Teléfono (Opcional)", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.telephone_field :phone, autocomplete: "tel", class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;", placeholder: "+1234567890" %>
      </div>

      <div>
        <%= f.label :password, "Contraseña", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;" %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-sm text-gray-500">Mínimo <%= @minimum_password_length %> caracteres</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirmar Contraseña", class: "block text-sm font-medium", style: "color: #2C3A43;" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", style: "focus-ring-color: #FCA50F; focus-border-color: #FCA50F;" %>
      </div>

      <div>
        <%= f.submit "Registrarse", class: "w-full text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline", style: "background-color: #FCA50F;" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
