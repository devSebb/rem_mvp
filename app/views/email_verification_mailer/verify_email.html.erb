<% content_for :preview_title, "Tu código de verificación Papayal" %>
<% content_for :preheader do %>Tu código es <%= @otp %> — vence en 10 minutos.<% end %>

<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Verifica tu correo
</div>

<h1 style="margin:0 0 18px 0; font-size:28px; line-height:1.2; font-weight:800; letter-spacing:-0.6px; color:#0D2F32;">
  Ya casi, <%= @first_name %> 👋
</h1>

<p style="margin:0 0 8px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  Para terminar de crear tu cuenta, ingresa este código en la app:
</p>

<!-- Code box -->
<div style="text-align:center; background:#FDF1E1; border:1px solid #F1E2CB; border-radius:14px; padding:20px 0; margin:22px 0;">
  <div style="font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:36px; letter-spacing:12px; font-weight:800; color:#0D2F32; padding-left:12px;">
    <%= @otp %>
  </div>
</div>

<p style="margin:0 0 4px 0; font-size:14px; line-height:1.6; color:#6A7780;">
  Vence en 10 minutos. Si no intentaste crear una cuenta en Papayal, puedes
  ignorar este mensaje — no se creará ninguna cuenta sin este código.
</p>
