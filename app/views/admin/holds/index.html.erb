<div class="max-w-6xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Security Holds</h1>
      <p class="text-sm text-gray-600 mt-1">
        Gift cards under 24h security review (Stripe Radar risk score ≥ <%= GiftCard::RISK_HOLD_THRESHOLD %>).
      </p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded text-green-800"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded text-red-800"><%= flash[:alert] %></div>
  <% end %>

  <% if @held_gift_cards.empty? %>
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">
      No hay tarjetas bajo bloqueo de seguridad en este momento.
    </div>
  <% else %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Buyer</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Recipient</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Merchant</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Risk</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Unlocks At</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @held_gift_cards.each do |gc| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm font-mono text-gray-600">#<%= gc.id %></td>
              <td class="px-4 py-3 text-sm">
                <div class="text-gray-900"><%= gc.sender&.email %></div>
                <div class="text-xs text-gray-500">ID <%= gc.sender_id %></div>
              </td>
              <td class="px-4 py-3 text-sm">
                <div class="text-gray-900"><%= gc.recipient&.email %></div>
                <% if gc.recipient&.phone.present? %>
                  <div class="text-xs text-gray-500"><%= gc.recipient.phone %></div>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= gc.merchant&.store_name %></td>
              <td class="px-4 py-3 text-sm text-right text-gray-900 font-semibold">
                <%= number_to_currency(gc.amount / 100.0) %>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                  <%= gc.risk_score.to_i >= 75 ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>">
                  <%= gc.risk_score %> · <%= gc.risk_level || 'unknown' %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700">
                <div><%= l(gc.held_until, format: :short) rescue gc.held_until.strftime("%Y-%m-%d %H:%M %Z") %></div>
                <div class="text-xs text-gray-500"><%= time_ago_in_words(gc.held_until) %> remaining</div>
              </td>
              <td class="px-4 py-3 text-right">
                <%= form_with url: release_admin_hold_path(gc), method: :post, local: true, class: "inline-flex items-center gap-2" do |f| %>
                  <%= f.text_field :reason, placeholder: "Reason (required)", required: true,
                        class: "text-xs border border-gray-300 rounded px-2 py-1 w-44" %>
                  <%= f.submit "Release",
                        class: "text-xs bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-1 rounded",
                        data: { confirm: "Liberar el bloqueo de la tarjeta ##{gc.id}? Esta acción se registrará." } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
