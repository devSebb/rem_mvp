<% content_for :title, "Papayal · Reembolso REM-#{@gift_card.id.to_s.last(6)}" %>
<div class="max-w-3xl mx-auto space-y-8">
  <div class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="papayal-meta text-[#0D2F32]">Panel Tarjetas</p>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold text-[#0D2F32]">Emitir reembolso</h1>
        <span class="<%= status_badge_classes(@gift_card.status) %>"><%= status_badge_label(@gift_card.status) %></span>
        <%= gift_card_flag_badges(@gift_card) %>
      </div>
      <p class="text-sm text-[#2C3A43]/70 mt-1">
        Tarjeta REM-<%= @gift_card.id.to_s.last(6) %> · <%= @gift_card.merchant&.store_name || "Sin comercio" %>
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Volver a la tarjeta", admin_gift_card_path(@gift_card), class: "papayal-btn-ghost" %>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-4">
    <div class="col-span-6 md:col-span-3 papayal-card p-5">
      <p class="papayal-meta">Monto</p>
      <p class="text-2xl font-bold mt-2"><%= number_to_currency(@gift_card.amount / 100.0, unit: '$') %></p>
    </div>
    <div class="col-span-6 md:col-span-3 papayal-card p-5">
      <p class="papayal-meta">Saldo restante</p>
      <p class="text-2xl font-bold mt-2 text-emerald-700"><%= number_to_currency(@gift_card.remaining_balance / 100.0, unit: '$') %></p>
    </div>
    <div class="col-span-6 md:col-span-3 papayal-card p-5">
      <p class="papayal-meta">Canjeado</p>
      <p class="text-2xl font-bold mt-2 text-blue-700"><%= number_to_currency(@total_redeemed / 100.0, unit: '$') %></p>
    </div>
    <div class="col-span-6 md:col-span-3 papayal-card p-5">
      <p class="papayal-meta">Máx. reembolsable</p>
      <p class="text-2xl font-bold mt-2 text-rose-700"><%= number_to_currency(@max_refund_amount / 100.0, unit: '$') %></p>
    </div>
  </div>

  <div class="papayal-card p-6 space-y-6">
    <div class="p-4 rounded-2xl border border-amber-200 bg-amber-50 text-sm text-amber-800">
      <p class="font-semibold">Importante</p>
      <p class="mt-1">
        Esto devuelve dinero al método de pago original del comprador en Stripe y reduce el saldo
        disponible de la tarjeta (un reembolso total la cancela). El valor ya canjeado no se puede
        reembolsar. Esta acción no se puede deshacer.
      </p>
    </div>

    <%= form_with url: admin_gift_card_refunds_path(@gift_card), method: :post, local: true, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :refund_amount, "Monto a reembolsar", class: "block text-sm font-medium text-[#0D2F32] mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <span class="text-[#2C3A43]/60 text-sm">$</span>
          </div>
          <%= form.number_field :refund_amount,
              step: 0.01,
              min: 0.01,
              max: @max_refund_amount / 100.0,
              required: true,
              class: "papayal-input w-full pl-8",
              placeholder: "0.00" %>
        </div>
        <p class="mt-1 text-xs text-[#2C3A43]/70">
          Máximo reembolsable: <%= number_to_currency(@max_refund_amount / 100.0, unit: '$') %> (el valor canjeado no se devuelve al comprador).
        </p>
      </div>

      <div>
        <%= form.label :reason, "Motivo del reembolso", class: "block text-sm font-medium text-[#0D2F32] mb-2" %>
        <%= form.text_area :reason,
            rows: 3,
            required: true,
            class: "papayal-input w-full",
            placeholder: "Explica por qué se emite este reembolso…" %>
        <p class="mt-1 text-xs text-[#2C3A43]/70">El motivo queda registrado en el historial de movimientos de la tarjeta.</p>
      </div>

      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancelar", admin_gift_card_path(@gift_card), class: "papayal-btn-ghost" %>
        <%= form.submit "Emitir reembolso",
            class: "papayal-btn-primary bg-rose-600 hover:bg-rose-700 text-white cursor-pointer",
            data: {
              disable_with: "Procesando…",
              turbo_confirm: "¿Emitir este reembolso al comprador? Esta acción no se puede deshacer."
            } %>
      </div>
    <% end %>
  </div>
</div>
