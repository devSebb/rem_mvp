<% content_for :title, "Papayal · Comercios" %>
<div class="space-y-8">
  <div class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="papayal-meta text-[#0D2F32]">Panel Comercios</p>
      <h1 class="text-2xl font-bold text-[#0D2F32]">Gestión de comercios</h1>
      <p class="text-sm text-[#2C3A43]/80 mt-1">
        Administra los socios activos y crea nuevos accesos de comercio.
        <span class="font-semibold"><%= @total_count %></span> resultado<%= "s" unless @total_count == 1 %>.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Crear nuevo comercio", new_admin_merchant_path, class: "papayal-btn-primary" %>
    </div>
  </div>

  <% if @created_merchant.present? %>
    <div class="papayal-card p-6 border border-emerald-100 bg-emerald-50">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="papayal-meta text-emerald-700">Comercio creado</p>
          <h2 class="text-xl font-semibold text-[#0D2F32]"><%= @created_merchant.store_name %></h2>
          <p class="text-sm text-[#2C3A43]/80 mt-1">Propietario: <%= @created_merchant.user&.name %> • <%= @created_merchant.user&.email %></p>
        </div>
        <span class="<%= status_badge_classes(@created_merchant.status) %>"><%= status_badge_label(@created_merchant.status) %></span>
      </div>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div class="p-4 rounded-2xl bg-white border border-emerald-100">
          <p class="papayal-meta text-[#2C3A43]/70">Public Key</p>
          <p class="font-semibold text-[#0D2F32] break-words"><%= @created_merchant.public_key %></p>
        </div>
        <% if @generated_secret_key.present? %>
          <div class="p-4 rounded-2xl bg-white border border-emerald-100">
            <p class="papayal-meta text-[#2C3A43]/70">Secret Key (copiar y guardar)</p>
            <p class="font-semibold text-[#0D2F32] break-words"><%= @generated_secret_key %></p>
          </div>
        <% end %>
        <% if @generated_password.present? %>
          <div class="p-4 rounded-2xl bg-white border border-emerald-100">
            <p class="papayal-meta text-[#2C3A43]/70">Contraseña inicial</p>
            <p class="font-semibold text-[#0D2F32] break-words"><%= @generated_password %></p>
          </div>
        <% end %>
      </div>
      <p class="text-xs text-[#2C3A43]/70 mt-3">La clave secreta solo se muestra una vez. Compártela de forma segura con el comercio.</p>
    </div>
  <% end %>

  <div class="papayal-card p-6 space-y-4"
       data-controller="view-toggle"
       data-view-toggle-storage-key-value="admin_merchants_view">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="papayal-meta">Comercios</p>
        <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Listado de comercios</h2>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex rounded-full border border-black/10 overflow-hidden" role="group" aria-label="Modo de vista">
          <button type="button"
                  data-view-toggle-target="listButton"
                  data-action="view-toggle#showList"
                  class="px-4 py-1.5 text-sm font-medium transition-colors bg-white text-[#2C3A43]">
            Lista
          </button>
          <button type="button"
                  data-view-toggle-target="gridButton"
                  data-action="view-toggle#showGrid"
                  class="px-4 py-1.5 text-sm font-medium transition-colors bg-white text-[#2C3A43]">
            Cuadrícula
          </button>
        </div>
        <%= link_to "Nuevo", new_admin_merchant_path, class: "papayal-btn-secondary text-sm" %>
      </div>
    </div>

    <%= form_with url: admin_merchants_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do %>
      <input type="text" name="q" value="<%= @query %>" placeholder="Buscar por comercio, correo, propietario o public key…" class="papayal-input flex-1">
      <input type="hidden" name="filter" value="<%= @filter %>">
      <button type="submit" class="papayal-btn-primary">Buscar</button>
      <% if @query.present? %>
        <%= link_to "Limpiar", admin_merchants_path(filter: @filter), class: "papayal-btn-ghost" %>
      <% end %>
    <% end %>

    <div class="flex flex-wrap gap-2">
      <% { "all" => "Todos", "active" => "Activos", "suspended" => "Suspendidos" }.each do |key, label| %>
        <%= link_to "#{label} (#{@status_counts[key]})", admin_merchants_path(filter: key, q: @query.presence),
              class: "px-4 py-1.5 rounded-full text-sm font-medium border transition-colors #{@filter == key ? 'bg-[#0D2F32] text-white border-[#0D2F32]' : 'bg-white text-[#2C3A43] border-black/10 hover:border-[#FCA50F]/50'}" %>
      <% end %>
    </div>

    <% if @merchants.any? %>
      <div data-view-toggle-target="list">
        <div class="overflow-x-auto rounded-2xl border border-black/5">
          <table class="min-w-full divide-y divide-black/5">
            <thead class="bg-[#EBEBEB]/60 text-left text-sm font-medium text-[#2C3A43]/70 uppercase tracking-wider">
              <tr>
                <th class="px-4 py-3">Comercio</th>
                <th class="px-4 py-3">Propietario</th>
                <th class="px-4 py-3">Estado</th>
                <th class="px-4 py-3 text-right">Tarjetas</th>
                <th class="px-4 py-3 text-right">Vol. emitido</th>
                <th class="px-4 py-3 text-right">Vol. canjeado</th>
                <th class="px-4 py-3 text-right">Saldo activo</th>
                <th class="px-4 py-3">Creado</th>
                <th class="px-4 py-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-black/5 text-sm">
              <% @merchants.each do |merchant| %>
                <%= render "merchant_row", merchant: merchant, stats: @merchant_stats.fetch(merchant.id) %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div data-view-toggle-target="grid" class="hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          <% @merchants.each do |merchant| %>
            <%= render "merchant_card", merchant: merchant, stats: @merchant_stats.fetch(merchant.id) %>
          <% end %>
        </div>
      </div>

      <% if @total_pages > 1 %>
        <div class="flex items-center justify-between text-sm text-[#2C3A43]/70 pt-2">
          <span>Página <%= @page %> de <%= @total_pages %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Anterior", admin_merchants_path(filter: @filter, q: @query.presence, page: @page - 1), class: "papayal-btn-ghost text-xs" %>
            <% end %>
            <% if @page < @total_pages %>
              <%= link_to "Siguiente →", admin_merchants_path(filter: @filter, q: @query.presence, page: @page + 1), class: "papayal-btn-ghost text-xs" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-10 text-sm text-[#2C3A43]/70">
        No se encontraron comercios<%= " para \"#{@query}\"" if @query.present? %>.
      </div>
    <% end %>
  </div>
</div>
