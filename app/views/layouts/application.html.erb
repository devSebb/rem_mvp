<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Papayal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/Papayal-logoV2Tag.png" type="image/png">
    <link rel="apple-touch-icon" href="/Papayal-logoV2Tag.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body
    class="min-h-screen bg-[#EBEBEB] text-[#2C3A43]"
    data-controller="locale"
    data-locale-default="es"
    data-title-es="<%= content_for(:title_es) || content_for(:title) || 'Papayal' %>"
    data-title-en="<%= content_for(:title_en) || content_for(:title) || 'Papayal' %>">
    <div class="min-h-screen flex flex-col">
      <!-- Navigation -->
      <nav class="bg-white/95 backdrop-blur border-b border-black/5 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex h-16 items-center justify-between gap-6">
            <div class="flex items-center gap-3">
              <%= link_to navbar_home_path, class: "flex items-center gap-3" do %>
                <div class="h-10 w-10  flex items-center justify-center overflow-hidden">
                  <picture>
                    <source type="image/webp" srcset="/optimized/papayal-logo-128.webp">
                    <%= image_tag "/Papayal-logoV2Tag.png", alt: "Papayal", width: 128, height: 128, class: "h-10 w-10 object-cover", loading: "eager", decoding: "async" %>
                  </picture>
                </div>
                <div>
                  <p class="text-xl font-bold text-[#0D2F32]">Papayal</p>
                  <p class="text-xs text-[#2C3A43]/70"><%= navbar_subtitle %></p>
                </div>
              <% end %>
              <% if current_user&.admin? %>
                <span class="hidden sm:inline-flex items-center text-xs font-semibold tracking-wide uppercase px-3 py-1 rounded-full bg-[#0D2F32] text-white">Admin</span>
              <% end %>
            </div>
            
            <!-- Desktop Navigation -->
            <div class="desktop-navigation hidden md:flex items-center gap-2">
              <% if public_legal_page? %>
                <%= render "shared/language_toggle" %>
              <% end %>
              <% if admin_nav_context? %>
                <% admin_nav_links.each do |label, path, controllers| %>
                  <%= link_to label, path,
                        class: "text-sm px-3 py-1.5 rounded-full font-medium transition-colors #{admin_nav_link_active?(controllers) ? 'bg-[#0D2F32] text-white' : 'text-[#2C3A43] hover:bg-black/5'}" %>
                <% end %>
                <%= button_to "Salir", destroy_user_session_path, method: :delete, class: "papayal-btn-ghost text-sm", form: { class: "contents" } %>
              <% elsif user_signed_in? %>
                <% unless current_user&.merchant? || merchant_nav_context? %>
                  <%= link_to "Inicio", navbar_home_path, class: "papayal-btn-ghost text-sm" %>
                <% end %>
                <% if current_user.admin? %>
                  <%= link_to "Mi Billetera", gift_cards_path, class: "papayal-btn-ghost text-sm" %>
                <% elsif !current_user.merchant? %>
                  <%= link_to "Papayal App", proximamente_path, class: "papayal-btn-ghost text-sm" %>
                <% end %>
                <% if current_user.merchant? %>
                  <%= link_to "Portal Comercio", merchant_root_path, class: "papayal-btn-ghost text-sm" %>
                <% end %>
                <%= link_to "Perfil", edit_user_registration_path, class: "papayal-btn-secondary text-sm" %>
                <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "papayal-btn-ghost text-sm", form: { class: "contents" } %>
              <% else %>
                <%= link_to "Iniciar Sesión", new_user_session_path, class: "papayal-btn-ghost text-sm" %>
                <%= link_to "Registrarse", new_user_registration_path, class: "papayal-btn-primary text-sm" %>
              <% end %>
            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden flex items-center gap-2">
              <% if public_legal_page? %>
                <%= render "shared/language_toggle" %>
              <% end %>
              <button type="button" class="mobile-menu-button bg-white inline-flex items-center justify-center p-2 rounded-xl text-[#0D2F32] hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FCA50F]" aria-controls="mobile-menu" aria-expanded="false">
                <span class="sr-only">Abrir menú principal</span>
                <svg class="hamburger-icon block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg class="close-icon hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Mobile menu -->
          <div class="md:hidden hidden pb-6" id="mobile-menu">
            <div class="space-y-2 border-t border-black/5 pt-4">
              <% if admin_nav_context? %>
                <% admin_nav_links.each do |label, path, controllers| %>
                  <%= link_to label, path,
                        class: "block w-full text-left px-4 py-2 rounded-xl text-sm font-medium #{admin_nav_link_active?(controllers) ? 'bg-[#0D2F32] text-white' : 'text-[#2C3A43] hover:bg-black/5'}" %>
                <% end %>
                <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "w-full papayal-btn-ghost justify-center", form: { class: "w-full" } %>
              <% elsif user_signed_in? %>
                <% unless current_user&.merchant? || merchant_nav_context? %>
                  <%= link_to "Inicio", navbar_home_path, class: "block w-full papayal-btn-ghost text-left justify-start" %>
                <% end %>
                <% if current_user.admin? %>
                  <%= link_to "Mi Billetera", gift_cards_path, class: "block w-full papayal-btn-ghost text-left justify-start" %>
                <% elsif !current_user.merchant? %>
                  <%= link_to "Papayal App", proximamente_path, class: "block w-full papayal-btn-ghost text-left justify-start" %>
                <% end %>
                <% if current_user.merchant? %>
                  <%= link_to "Portal Comercio", merchant_root_path, class: "block w-full papayal-btn-ghost text-left justify-start" %>
                <% end %>
                <%= link_to "Perfil", edit_user_registration_path, class: "block w-full papayal-btn-secondary text-center" %>
                <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "w-full papayal-btn-ghost justify-center", form: { class: "w-full" } %>
              <% else %>
                <%= link_to "Iniciar Sesión", new_user_session_path, class: "block w-full papayal-btn-ghost text-center" %>
                <%= link_to "Registrarse", new_user_registration_path, class: "block w-full papayal-btn-primary text-center" %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>

      <!-- Flash messages -->
      <div class="max-w-7xl mx-auto w-full px-6 pt-4 space-y-3">
        <% if notice %>
          <div class="papayal-card border-green-200 bg-green-50 text-green-800 px-4 py-3 flex items-center gap-3">
            <span class="papayal-meta text-green-700">Aviso</span>
            <p class="text-sm text-green-800"><%= notice %></p>
          </div>
        <% end %>
        
        <% if alert %>
          <div class="papayal-card border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 flex items-center gap-3">
            <span class="papayal-meta text-rose-700">Alerta</span>
            <p class="text-sm text-rose-800"><%= alert %></p>
          </div>
        <% end %>
      </div>

      <!-- Main content -->
      <main class="flex-1 w-full">
        <div class="max-w-7xl mx-auto w-full px-6 py-6">
          <%= yield %>
        </div>
      </main>

      <!-- Footer -->
      <footer class="bg-white/95 backdrop-blur border-t border-black/5 mt-auto">
        <div class="max-w-7xl mx-auto px-6 py-4">
          <div class="flex items-center justify-between gap-4">
            <!-- Logo -->
            <div class="flex items-center gap-2">
              <div class="h-8 w-8  flex items-center justify-center overflow-hidden">
                <picture>
                  <source type="image/webp" srcset="/optimized/papayal-logo-128.webp">
                  <%= image_tag "/Papayal-logoV2Tag.png", alt: "Papayal", width: 128, height: 128, class: "h-8 w-8 object-cover", loading: "lazy", decoding: "async" %>
                </picture>
              </div>
            </div>

            <!-- Copyright -->
            <div class="flex-1 text-center">
              <p class="text-xs text-[#2C3A43]/70">
                <%= localized_text es: "© Todos los derechos reservados Papayal 2026", en: "© All rights reserved Papayal 2026" %>
              </p>
            </div>

            <!-- Legal Hub Link -->
            <div class="flex items-center">
              <%= link_to legal_path, class: "text-xs text-[#2C3A43]/70 hover:text-[#0D2F32] transition-colors" do %>
                <%= localized_text es: "Hub Legal", en: "Legal Hub" %>
              <% end %>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Mobile menu toggle - works with Turbo
      function setupMobileMenu() {
        const mobileMenuButton = document.querySelector('.mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (mobileMenuButton && mobileMenu) {
          // Remove any existing listeners by cloning the button
          const newButton = mobileMenuButton.cloneNode(true);
          mobileMenuButton.parentNode.replaceChild(newButton, mobileMenuButton);
          
          // Ensure menu starts hidden
          mobileMenu.classList.add('hidden');
          
          newButton.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const isHidden = mobileMenu.classList.contains('hidden');
            
            if (isHidden) {
              // Show menu
              mobileMenu.classList.remove('hidden');
              newButton.setAttribute('aria-expanded', 'true');
            } else {
              // Hide menu
              mobileMenu.classList.add('hidden');
              newButton.setAttribute('aria-expanded', 'false');
            }
            
            // Toggle hamburger and close icons
            const hamburgerIcon = newButton.querySelector('.hamburger-icon');
            const closeIcon = newButton.querySelector('.close-icon');
            
            if (hamburgerIcon && closeIcon) {
              if (isHidden) {
                // Menu is opening - show close icon, hide hamburger
                hamburgerIcon.classList.add('hidden');
                closeIcon.classList.remove('hidden');
              } else {
                // Menu is closing - show hamburger icon, hide close
                hamburgerIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
              }
            }
          });
        }
      }
      
      // Setup on Turbo navigation (includes first load)
      document.addEventListener('turbo:load', setupMobileMenu);
    </script>
  </body>
</html>
