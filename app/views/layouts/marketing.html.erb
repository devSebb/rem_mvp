<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Papayal | Envía ayuda a Ecuador" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:meta_description) || 'Papayal offers prepaid digital gift cards for purchases with partner merchants in Ecuador.' %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:title_en) || content_for(:title) || 'Papayal' %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || 'Papayal offers prepaid digital gift cards for purchases with partner merchants in Ecuador.' %>">
    <meta property="og:image" content="/optimized/hero-card-group-1600.webp">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/Papayal_favicon1.png" type="image/png">
    <link rel="apple-touch-icon" href="/Papayal_favicon1.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body
    class="marketing-body"
    data-controller="locale marketing"
    data-locale-default="es"
    data-title-es="<%= content_for(:title_es) || content_for(:title) || 'Papayal | Envía ayuda a Ecuador' %>"
    data-title-en="<%= content_for(:title_en) || content_for(:title) || 'Papayal | Prepaid Digital Gift Cards' %>">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-sm">
      <%= localized_text es: "Saltar al contenido principal", en: "Skip to main content" %>
    </a>

    <%= render "marketing/navbar" %>

    <main id="main-content">
      <%= yield %>
    </main>

    <%= render "marketing/footer" %>
  </body>
</html>
