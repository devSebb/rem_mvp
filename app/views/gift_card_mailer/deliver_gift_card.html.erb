<% content_for :preview_title, "Recibiste una tarjeta de regalo Papayal" %>
<% content_for :preheader do %><%= @sender.name %> te envió una tarjeta de regalo de <%= @gift_card.currency %> <%= format("%.2f", @gift_card.amount / 100.0) %>.<% end %>

<!-- Eyebrow -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:14px;">
  Recibiste un regalo
</div>

<h1 style="margin:0 0 18px 0; font-size:30px; line-height:1.2; font-weight:800; letter-spacing:-0.8px; color:#0D2F32;">
  ¡Tienes una tarjeta de regalo Papayal!
</h1>

<p style="margin:0 0 22px 0; font-size:16px; line-height:1.65; color:#2C3A43;">
  <%= @sender.name %> te envió una tarjeta de regalo para que la disfrutes en los comercios afiliados de Papayal.
</p>

<!-- Amount -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td align="center" style="padding:22px 0; background-color:#FDF1E1; border:1px solid #F1E2CB; border-radius:16px;">
      <div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:6px;">
        Monto
      </div>
      <div style="font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:38px; font-weight:800; letter-spacing:-1px; color:#0D2F32;">
        <%= @gift_card.currency %> <%= format("%.2f", @gift_card.amount / 100.0) %>
      </div>
    </td>
  </tr>
</table>

<!-- Sender info -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="padding:16px 18px; background-color:#FFFFFF; border:1px solid #F1E2CB; border-radius:12px; font-size:15px; line-height:1.6; color:#2C3A43;">
      <strong style="color:#0D2F32;">De:</strong> <%= @sender.name %><br>
      <strong style="color:#0D2F32;">Email:</strong> <%= @sender.email %>
    </td>
  </tr>
</table>

<!-- Security notice -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 28px 0;">
  <tr>
    <td style="padding:16px 18px; background-color:#FDF1E1; border:1px solid #F1E2CB; border-radius:12px; font-size:14px; line-height:1.6; color:#2C3A43;">
      <strong style="color:#0D2F32;">🔒 Importante:</strong><br>
      Por seguridad, el QR y el código de canje no se envían por correo. Abre Papayal cuando estés listo para usar tu tarjeta y genera un código vigente desde la app.
    </td>
  </tr>
</table>

<!-- CTA -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 28px auto;">
  <tr>
    <td align="center" bgcolor="#FCA50F" style="border-radius:999px;">
      <a href="<%= @gift_card_url %>" class="pyl-btn"
         style="display:inline-block; padding:15px 38px; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:700; color:#3A1E00; text-decoration:none; border-radius:999px;">
        Ver mi tarjeta en Papayal
      </a>
    </td>
  </tr>
</table>

<!-- How to redeem -->
<div style="font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#E08A00; margin-bottom:12px;">
  Cómo canjear
</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 4px 0;">
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">1</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Abre Papayal e ingresa a tu billetera.</td>
  </tr>
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">2</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Selecciona esta tarjeta de regalo.</td>
  </tr>
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">3</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Genera el QR o código de canje dentro de la app.</td>
  </tr>
  <tr>
    <td width="34" valign="top" style="padding:8px 0; font-family:'Raleway',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; font-weight:800; color:#E08A00;">4</td>
    <td style="padding:8px 0; font-size:15px; line-height:1.55; color:#2C3A43;">Muéstralo al cajero del comercio participante.</td>
  </tr>
</table>
