<footer class="landing-footer" id="contacto">
  <div class="landing-container">
    <div class="landing-footer-grid">
      <div class="landing-footer-brand">
        <%= link_to root_path, class: "landing-brand" do %>
          <img src="/optimized/papayal-logo-128.webp" width="36" height="36" alt="" loading="lazy" decoding="async">
          <span>Papayal</span>
        <% end %>
        <p><%= localized_text es: "Tarjetas de regalo digitales para usar en comercios participantes en Ecuador.", en: "Digital gift cards for use at participating businesses in Ecuador." %></p>
        <p><%= localized_text es: "¿Tienes preguntas? Escríbenos.", en: "Have questions? Get in touch." %></p>
        <a href="mailto:hola@papayal.app">hola@papayal.app</a>
      </div>
      <nav aria-label="Papayal">
        <%= link_to about_path do %><%= localized_text es: "Sobre Papayal", en: "About Papayal" %><% end %>
        <%= link_to contact_path do %><%= localized_text es: "Contacto", en: "Contact" %><% end %>
        <%= link_to new_user_session_path do %><%= localized_text es: "Acceso para comercios", en: "Merchant access" %><% end %>
        <a href="https://www.instagram.com/papayalapp/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </nav>
      <nav aria-label="Información legal" data-locale-attrs="aria-label" data-locale-aria-label-es="Información legal" data-locale-aria-label-en="Legal information">
        <% [[legal_terminos_path, "Términos de servicio", "Terms of service"], [legal_privacidad_path, "Privacidad", "Privacy"], [legal_tarjetas_regalo_path, "Términos de las tarjetas", "Gift card terms"], [legal_pagos_reembolsos_path, "Pagos y reembolsos", "Payments and refunds"], [legal_path, "Información legal", "Legal information"]].each do |path, es, en| %>
          <%= link_to path do %><%= localized_text es: es, en: en %><% end %>
        <% end %>
      </nav>
    </div>
    <div class="landing-footer-bottom">
      <p><%= localized_text es: "© #{Time.current.year} Papayal. Todos los derechos reservados.", en: "© #{Time.current.year} Papayal. All rights reserved." %></p>
      <div class="landing-footer-stores">
        <% if (url = marketing_store_url(:ios)) %><%= link_to "App Store", url, data: marketing_store_link_data(:ios) %><% end %>
        <% if (url = marketing_store_url(:android)) %><%= link_to "Google Play", url, data: marketing_store_link_data(:android) %><% end %>
      </div>
    </div>
  </div>
</footer>
