<header class="marketing-nav-wrap">
  <nav class="marketing-nav" aria-label="Primary">
    <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-6 lg:px-8">
      <%= link_to root_path, class: "flex items-center gap-3", aria: { label: "Go to Papayal homepage" } do %>
        <picture>
          <source type="image/webp" srcset="/optimized/papayal-logo-128.webp">
          <img src="/Papayal-logoV2Tag.png" alt="Papayal" width="128" height="128" decoding="async" class="h-9 w-9" />
        </picture>
        <span class="marketing-logo-text text-2xl font-black tracking-tight text-[#14343A]">Papayal</span>
      <% end %>

      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[#14343A]/15 bg-white/85 text-[#14343A] md:hidden"
        aria-controls="marketing-mobile-menu"
        aria-expanded="false"
        data-marketing-target="menuButton"
        data-action="click->marketing#toggleMenu">
        <span class="sr-only"><%= localized_text es: "Abrir menú", en: "Open menu" %></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>

      <div class="hidden items-center gap-1 md:flex">
        <%= link_to root_path, class: "marketing-nav-link #{current_page?(root_path) ? "is-active" : ""}" do %>
          <%= localized_text es: "Inicio", en: "Home" %>
        <% end %>
        <%= link_to about_path, class: "marketing-nav-link #{current_page?(about_path) ? "is-active" : ""}" do %>
          <%= localized_text es: "Sobre Nosotros", en: "About" %>
        <% end %>
        <%= link_to root_path(anchor: "como-funciona"), class: "marketing-nav-link", data: { action: "click->marketing#handleAnchorClick" } do %>
          <%= localized_text es: "Cómo funciona", en: "How it works" %>
        <% end %>
        <%= link_to root_path(anchor: "beneficios"), class: "marketing-nav-link", data: { action: "click->marketing#handleAnchorClick" } do %>
          <%= localized_text es: "Beneficios", en: "Benefits" %>
        <% end %>
        <%= link_to contact_path, class: "marketing-nav-link #{current_page?(contact_path) ? "is-active" : ""}" do %>
          <%= localized_text es: "Contacto", en: "Contact" %>
        <% end %>
      </div>

      <div class="hidden items-center gap-2 md:flex">
        <%= render "shared/language_toggle" %>
        <% if user_signed_in? %>
          <% if current_user.merchant? %>
            <%= link_to merchant_root_path, class: "marketing-signup-btn" do %>
              <%= localized_text es: "Portal Comercio", en: "Merchant Portal" %>
            <% end %>
          <% elsif current_user.admin? %>
            <%= link_to admin_root_path, class: "marketing-signup-btn" do %>
              <%= localized_text es: "Panel Admin", en: "Admin Panel" %>
            <% end %>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete, class: "marketing-login-btn", form: { class: "contents" } do %>
            <%= localized_text es: "Cerrar Sesión", en: "Sign Out" %>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path, class: "marketing-login-btn" do %>
            <%= localized_text es: "Iniciar Sesión", en: "Sign In" %>
          <% end %>
          <%= link_to new_user_registration_path, class: "marketing-signup-btn" do %>
            <%= localized_text es: "Registrarse", en: "Sign Up" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div id="marketing-mobile-menu" class="hidden border-t border-[#14343A]/10 bg-white/95 md:hidden" data-marketing-target="mobileMenu">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-1 px-5 py-4 sm:px-6">
        <div class="mb-2 flex justify-start">
          <%= render "shared/language_toggle" %>
        </div>
        <%= link_to root_path, class: "marketing-mobile-link", data: { action: "click->marketing#closeMenu" } do %>
          <%= localized_text es: "Inicio", en: "Home" %>
        <% end %>
        <%= link_to about_path, class: "marketing-mobile-link", data: { action: "click->marketing#closeMenu" } do %>
          <%= localized_text es: "Sobre Nosotros", en: "About" %>
        <% end %>
        <%= link_to root_path(anchor: "como-funciona"), class: "marketing-mobile-link", data: { action: "click->marketing#handleAnchorClick click->marketing#closeMenu" } do %>
          <%= localized_text es: "Cómo funciona", en: "How it works" %>
        <% end %>
        <%= link_to root_path(anchor: "beneficios"), class: "marketing-mobile-link", data: { action: "click->marketing#handleAnchorClick click->marketing#closeMenu" } do %>
          <%= localized_text es: "Beneficios", en: "Benefits" %>
        <% end %>
        <%= link_to contact_path, class: "marketing-mobile-link", data: { action: "click->marketing#closeMenu" } do %>
          <%= localized_text es: "Contacto", en: "Contact" %>
        <% end %>
        <% if user_signed_in? %>
          <div class="mt-3 grid gap-2 <%= current_user.merchant? || current_user.admin? ? "grid-cols-2" : "grid-cols-1" %>">
            <% if current_user.merchant? %>
              <%= link_to merchant_root_path, class: "marketing-signup-btn text-center" do %>
                <%= localized_text es: "Portal Comercio", en: "Merchant Portal" %>
              <% end %>
            <% elsif current_user.admin? %>
              <%= link_to admin_root_path, class: "marketing-signup-btn text-center" do %>
                <%= localized_text es: "Panel Admin", en: "Admin Panel" %>
              <% end %>
            <% end %>
            <%= button_to destroy_user_session_path, method: :delete, class: "marketing-login-btn w-full text-center", form: { class: "contents" } do %>
              <%= localized_text es: "Cerrar Sesión", en: "Sign Out" %>
            <% end %>
          </div>
        <% else %>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <%= link_to new_user_session_path, class: "marketing-login-btn text-center" do %>
              <%= localized_text es: "Iniciar Sesión", en: "Sign In" %>
            <% end %>
            <%= link_to new_user_registration_path, class: "marketing-signup-btn text-center" do %>
              <%= localized_text es: "Registrarse", en: "Sign Up" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </nav>
</header>
