<header class="marketing-nav-wrap landing-header" data-action="keydown.esc->marketing#escapeMenu">
  <nav aria-label="Navegación principal" data-locale-attrs="aria-label" data-locale-aria-label-es="Navegación principal" data-locale-aria-label-en="Primary navigation">
    <div class="landing-container landing-nav-row">
      <%= link_to root_path, class: "landing-brand", aria: { label: "Inicio de Papayal" }, data: { locale_attrs: "aria-label", locale_aria_label_es: "Inicio de Papayal", locale_aria_label_en: "Papayal home" } do %>
        <img src="/optimized/papayal-logo-128.webp" width="36" height="36" alt="" decoding="async">
        <span>Papayal</span>
      <% end %>
      <div class="landing-desktop-nav">
        <% [["como-funciona", "Cómo funciona", "How it works"], ["mercado", "Comercios", "Businesses"], ["preguntas", "Preguntas", "FAQs"]].each do |anchor, es, en| %>
          <%= link_to root_path(anchor: anchor), class: "landing-nav-link", data: { action: "click->marketing#handleAnchorClick" } do %><%= localized_text es: es, en: en %><% end %>
        <% end %>
      </div>
      <div class="landing-nav-actions">
        <div class="landing-desktop-nav"><%= render "shared/language_toggle" %></div>
        <% if user_signed_in? %>
          <div class="landing-desktop-nav"><%= render "marketing/session_actions" %></div>
        <% else %>
          <%= link_to root_path(anchor: "descargar"), class: "landing-button landing-header-download", data: { action: "click->marketing#handleAnchorClick" } do %>
            <%= localized_text es: "Descargar", en: "Download" %>
          <% end %>
        <% end %>
        <button type="button" class="landing-menu-toggle" aria-controls="marketing-mobile-menu" aria-expanded="false"
          data-marketing-target="menuButton" data-action="click->marketing#toggleMenu">
          <span class="landing-menu-open sr-only"><%= localized_text es: "Abrir menú", en: "Open menu" %></span>
          <span class="landing-menu-close sr-only"><%= localized_text es: "Cerrar menú", en: "Close menu" %></span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path class="landing-menu-lines" d="M4 7h16M4 12h16M4 17h16" />
            <path class="landing-menu-cross" d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </div>
    </div>
    <div id="marketing-mobile-menu" class="hidden landing-mobile-menu" data-marketing-target="mobileMenu">
      <div class="landing-container">
        <%= render "shared/language_toggle" %>
        <% [["como-funciona", "Cómo funciona", "How it works"], ["mercado", "Comercios", "Businesses"], ["preguntas", "Preguntas", "FAQs"]].each do |anchor, es, en| %>
          <%= link_to root_path(anchor: anchor), class: "landing-nav-link", data: { action: "click->marketing#handleAnchorClick" } do %><%= localized_text es: es, en: en %><% end %>
        <% end %>
        <%= link_to about_path, class: "landing-nav-link", data: { action: "click->marketing#closeMenu" } do %><%= localized_text es: "Sobre Papayal", en: "About Papayal" %><% end %>
        <%= link_to contact_path, class: "landing-nav-link", data: { action: "click->marketing#closeMenu" } do %><%= localized_text es: "Contacto", en: "Contact" %><% end %>
        <% if user_signed_in? %>
          <%= render "marketing/session_actions" %>
        <% else %>
          <%= link_to new_user_session_path, class: "landing-nav-link landing-merchant-access" do %><%= localized_text es: "Acceso para comercios", en: "Merchant access" %><% end %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
