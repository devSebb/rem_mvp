<% content_for :title, "Contacto | Papayal" %>

<section class="relative overflow-hidden py-18 sm:py-24">
  <div class="hero-gradient hero-gradient-left"></div>
  <div class="hero-gradient hero-gradient-right"></div>
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="marketing-pill mx-auto" data-reveal>Contacto</p>
      <h1 class="mt-5 text-4xl font-black text-[#17363C] sm:text-5xl" data-reveal>Estamos aquí para ayudarte</h1>
      <p class="mt-4 text-lg text-[#66707A]" data-reveal>
        ¿Tienes preguntas sobre envíos, tiendas o soporte? Escríbenos y te responderemos pronto.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div class="rounded-[2rem] border border-white/70 bg-white/80 p-6 shadow-[0_35px_80px_-60px_rgba(19,53,61,0.8)] sm:p-8" data-reveal>
        <h2 class="text-2xl font-black text-[#17363C]">Envíanos un mensaje</h2>
        <p class="mt-2 text-sm text-[#66707A]">Formulario de contacto frontend (sin integración backend).</p>

        <form class="mt-6 space-y-4" data-action="submit->marketing#handleContactSubmit">
          <div>
            <label for="contact-name" class="papayal-label">Nombre completo</label>
            <input id="contact-name" type="text" required class="papayal-input mt-1 h-12" placeholder="Tu nombre" />
          </div>
          <div>
            <label for="contact-email" class="papayal-label">Correo electrónico</label>
            <input id="contact-email" type="email" required class="papayal-input mt-1 h-12" placeholder="tu@email.com" />
          </div>
          <div>
            <label for="contact-phone" class="papayal-label">Teléfono (opcional)</label>
            <input id="contact-phone" type="tel" class="papayal-input mt-1 h-12" placeholder="+593 99-000-0000" />
          </div>
          <div>
            <label for="contact-message" class="papayal-label">Mensaje</label>
            <textarea id="contact-message" required class="papayal-input mt-1 min-h-36" placeholder="Cuéntanos cómo podemos ayudarte"></textarea>
          </div>
          <button type="submit" class="marketing-signup-btn h-12 px-7">Enviar mensaje</button>
          <p class="hidden text-sm text-emerald-700" data-marketing-target="contactStatus">
            Gracias por escribirnos. Este formulario es visual y pronto conectaremos el envío real.
          </p>
        </form>
      </div>

      <aside class="space-y-4" data-reveal>
        <article class="marketing-feature-card">
          <h3 class="text-xl font-bold text-[#17363C]">Email</h3>
          <a href="mailto:papayalapp@gmail.com" class="mt-1 inline-block text-[#15353A] hover:underline">papayalapp@gmail.com</a>
        </article>
        <article class="marketing-feature-card">
          <h3 class="text-xl font-bold text-[#17363C]">Teléfono</h3>
          <a href="tel:+593992228365" class="mt-1 inline-block text-[#15353A] hover:underline">+593 99-222-8365</a>
        </article>
        <article class="marketing-feature-card">
          <h3 class="text-xl font-bold text-[#17363C]">Ubicación</h3>
          <p class="mt-1 text-[#66707A]">Quito, Ecuador</p>
        </article>
        <article class="marketing-feature-card">
          <h3 class="text-xl font-bold text-[#17363C]">Horario de soporte</h3>
          <p class="mt-1 text-[#66707A]">Lunes a sábado, 08:00 - 19:00 (ECT)</p>
        </article>
      </aside>
    </div>
  </div>
</section>
