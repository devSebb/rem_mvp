<% set_locale_titles es: "Papayal | Tarjetas de regalo para Ecuador", en: "Papayal | Gift cards for Ecuador" %>
<% content_for :meta_description, "Envía una tarjeta de regalo digital a tu familia en Ecuador. Consulta comercios participantes y descarga Papayal para iPhone o Android." %>
<% content_for :meta_description_en, "Send a digital gift card to your family in Ecuador. Explore participating businesses and download Papayal for iPhone or Android." %>
<% content_for :head do %>
  <%# The scroll story pins sections; a Turbo visit would keep stale pins, so always load this page fresh. %>
  <meta name="turbo-visit-control" content="reload">
  <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "landing", "data-turbo-track": "reload", type: "module" %>
<% end %>
<% content_for :navbar, render("marketing/landing_nav") %>

<%= render "marketing/landing/logo_sprite" %>

<div class="lp" data-landing>
  <%# ============================== HERO ============================== %>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-intro><%= localized_text es: "Tarjetas de regalo digitales", en: "Digital gift cards" %></p>
        <h1 class="display hero-title" id="hero-title">
          <%= locale_tag :es do %>
            <span class="line"><span>Envía <span class="hl">lo esencial</span></span></span>
            <span class="line"><span>a tu familia</span></span>
            <span class="line"><span>en Ecuador.</span></span>
          <% end %>
          <%= locale_tag :en do %>
            <span class="line"><span>Send <span class="hl">the essentials</span></span></span>
            <span class="line"><span>to your family</span></span>
            <span class="line"><span>in Ecuador.</span></span>
          <% end %>
        </h1>
        <p class="lead" data-intro><%= localized_text es: "Compra desde la app una tarjeta de regalo digital en dólares para farmacia, telefonía, mascotas y más. Tu familia la recibe en su celular y la canjea en el local.", en: "Buy a digital gift card in US dollars from the app, for pharmacy, phone, pets and more. Your family gets it on their phone and redeems it in store." %></p>
        <div data-intro><%= render "marketing/store_badges" %></div>
        <a class="text-link" href="#como-funciona" data-intro><%= localized_text es: "Mira cómo funciona", en: "See how it works" %> <span aria-hidden="true">↓</span></a>
      </div>

      <div class="hero-art" data-hero-art>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-stack">
          <div class="notif" data-notif aria-hidden="true">
            <span class="notif-icon"><svg><use href="#logo"/></svg></span>
            <span class="notif-text">
              <small><%= localized_text es: "Papayal · ahora", en: "Papayal · now" %></small>
              <strong><%= localized_text es: "Recibiste una tarjeta de regalo de $25", en: "You received a $25 gift card" %></strong>
            </span>
          </div>
          <%= render "marketing/landing/gift_card" %>
          <span class="pill" data-pill aria-hidden="true"><%= localized_text es: "Para: Mamá", en: "To: Mom" %></span>
          <p class="hero-hint" data-hint aria-hidden="true"><%= localized_text es: "Toca la tarjeta para girarla", en: "Tap the card to flip it" %></p>
        </div>
      </div>
    </div>
  </section>

  <%# ============================== ASÍ ENVÍAS (pinned) ============================== %>
  <section class="story story-send" id="como-funciona" aria-labelledby="send-title" tabindex="-1">
    <div class="stage" data-stage>
      <div class="wrap stage-grid">
        <div class="stage-copy">
          <p class="eyebrow"><%= localized_text es: "Desde Estados Unidos", en: "From the United States" %></p>
          <h2 class="display stage-title" id="send-title"><%= localized_text es: "Así envías.", en: "How you send." %></h2>
          <ol class="steps" data-steps>
            <% [
              ["Elige el comercio", "Choose the business", "Farmacia, telefonía, mascotas… lo que más le sirva a tu familia.", "Pharmacy, phone, pets… whatever helps your family most."],
              ["Elige el monto", "Choose the amount", "Desde $5. Pagas en dólares, directo en la app.", "From $5. You pay in US dollars, right in the app."],
              ["Dinos para quién es", "Tell us who it’s for", "Su nombre, su correo y, si quieres, una nota corta.", "Their name, their email and, if you like, a short note."],
              ["¡Tarjeta enviada!", "Gift card sent!", "Le avisamos por correo y la tarjeta queda lista en su app.", "We email them and the gift card is ready in their app."]
            ].each_with_index do |(title_es, title_en, body_es, body_en), index| %>
              <li class="step"><span class="step-num"><%= format("%02d", index + 1) %></span><div><h3><%= localized_text es: title_es, en: title_en %></h3><p><%= localized_text es: body_es, en: body_en %></p></div></li>
            <% end %>
          </ol>
        </div>
        <div class="stage-phone">
          <div class="studio-glow" aria-hidden="true"></div>
          <svg class="shock" data-shock viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="10"/></svg>
          <div class="phone" data-phone="send" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <%# ============================== VIAJE ============================== %>
  <section class="trip" aria-labelledby="trip-title">
    <div class="trip-stage" data-trip-stage>
      <div class="wrap trip-inner">
        <div class="trip-board" data-trip role="img" aria-label="De Chicago a Quito" data-locale-attrs="aria-label" data-locale-aria-label-es="De Chicago a Quito" data-locale-aria-label-en="From Chicago to Quito">
          <div class="reel" aria-hidden="true"><div class="reel-track" data-reel>
            <span><%= localized_text es: "Nueva York", en: "New York" %></span><span>Miami</span><span><%= localized_text es: "Los Ángeles", en: "Los Angeles" %></span><span>Chicago</span>
          </div></div>
          <div class="reel reel-to" aria-hidden="true"><div class="reel-track" data-reel>
            <% %w[Guayaquil Cuenca Manta Quito].each do |city| %>
              <span><svg class="trip-arrow" viewBox="0 0 48 32"><path d="M2 16h40M30 4l12 12-12 12"/></svg><%= city %></span>
            <% end %>
          </div></div>
        </div>
        <h2 class="display trip-title" id="trip-title" data-trip-title><%= localized_text es: "Directo a tu familia.", en: "Straight to your family." %></h2>
      </div>
    </div>
  </section>

  <%# ============================== ASÍ LA USA (pinned) ============================== %>
  <section class="story story-receive" id="usar" aria-labelledby="receive-title" tabindex="-1">
    <div class="stage" data-stage>
      <div class="iris" data-iris aria-hidden="true"></div>
      <div class="iris-ring" data-iris-ring aria-hidden="true"></div>
      <div class="wrap stage-grid is-reversed" data-receive-content>
        <div class="stage-copy">
          <p class="eyebrow"><%= localized_text es: "En Ecuador", en: "In Ecuador" %></p>
          <h2 class="display stage-title" id="receive-title"><%= localized_text es: "Así la usa.", en: "How they use it." %></h2>
          <ol class="steps" data-steps>
            <% [
              ["Recibe tu regalo", "They get your gift", "Abre el enlace, crea su cuenta y reclama la tarjeta.", "They open the link, create an account and claim the gift card."],
              ["Ve su saldo", "They see the balance", "Su tarjeta y tu nota, siempre a mano en la app.", "Their gift card and your note, always at hand in the app."],
              ["Muestra el código en caja", "They show the code at checkout", "Un código QR y de barras para pagar en el local.", "A QR code and a barcode to pay in store."],
              ["¡Canje completo!", "Redeemed!", "El monto se descuenta de su saldo. Así de simple.", "The amount comes off their balance. That simple."]
            ].each_with_index do |(title_es, title_en, body_es, body_en), index| %>
              <li class="step"><span class="step-num"><%= format("%02d", index + 1) %></span><div><h3><%= localized_text es: title_es, en: title_en %></h3><p><%= localized_text es: body_es, en: body_en %></p></div></li>
            <% end %>
          </ol>
        </div>
        <div class="stage-phone">
          <div class="studio-glow" aria-hidden="true"></div>
          <svg class="shock" data-shock viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="10"/></svg>
          <div class="phone" data-phone="receive" aria-hidden="true"></div>
          <div class="notif notif-phone" data-notif aria-hidden="true">
            <span class="notif-icon"><svg><use href="#logo"/></svg></span>
            <span class="notif-text">
              <small><%= localized_text es: "Papayal · ahora", en: "Papayal · now" %></small>
              <strong><%= localized_text es: "Daniela te envió una tarjeta de $25", en: "Daniela sent you a $25 gift card" %></strong>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ============================== COMERCIOS ============================== %>
  <section class="merchants" id="comercios" aria-labelledby="merchants-title" tabindex="-1">
    <div class="wrap">
      <div class="section-intro">
        <p class="eyebrow"><%= localized_text es: "Comercios", en: "Businesses" %></p>
        <h2 class="display" id="merchants-title"><%= localized_text es: "Para lo esencial.", en: "For the essentials." %></h2>
        <p class="lead"><%= localized_text es: "Elige entre farmacia, telefonía, mascotas, recargas y seguros. Revisa dónde se acepta cada tarjeta antes de comprar.", en: "Choose from pharmacy, phone, pets, top-ups and insurance. Check where each gift card is accepted before you buy." %></p>
      </div>
      <ul class="cats" data-cats>
        <% [%w[farmacia Farmacia Pharmacy], %w[telefonia Telefonía Phone], %w[mascotas Mascotas Pets], %w[recargas Recargas Top-ups], %w[seguros Seguros Insurance]].each do |mark, es, en| %>
          <li class="cat" data-mark="<%= mark %>"><span class="cat-mark pui"></span><span class="cat-label"><%= localized_text es: es, en: en %></span></li>
        <% end %>
      </ul>
    </div>

    <% if @marketing_merchants.any? %>
      <div class="marquee-head wrap"><p class="marquee-label"><%= localized_text es: "Comercios participantes", en: "Participating businesses" %></p></div>
      <%# Each half of the track repeats the catalog so it is wider than the viewport; the track slides by exactly one half for a seamless loop. %>
      <% marquee_items = @marketing_merchants * (12.0 / @marketing_merchants.size).ceil %>
      <div class="marquee">
        <div class="marquee-track">
          <% 2.times do |copy| %>
            <%= tag.ul class: "marquee-list", data: { merchant_preview: copy.zero? || nil }, aria: { hidden: copy.positive? || nil } do %>
              <% marquee_items.each_with_index do |merchant, index| %>
                <%= tag.li class: "logo-tile", aria: { hidden: (copy.zero? && index >= @marketing_merchants.size) || nil } do %>
                  <% if merchant.logo.attached? %>
                    <%= image_tag url_for(merchant.logo), alt: merchant.store_name, loading: "lazy", decoding: "async", style: "height: #{marketing_logo_height(merchant.logo)}%" %>
                  <% else %>
                    <span class="logo-name"><%= merchant.store_name %></span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <% coverage = @marketing_merchants.filter_map(&:effective_coverage_text).uniq %>
      <% if coverage.any? %>
        <div class="wrap merchant-notes">
          <% coverage.each do |text| %>
            <p class="landing-merchant-note" lang="es"><%= text %></p>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="wrap merchant-empty landing-merchant-empty"><%= localized_text es: "Consulta los comercios disponibles en la app.", en: "Check the app for available businesses." %></p>
    <% end %>
  </section>

  <%# ============================== PREGUNTAS ============================== %>
  <section class="faq" id="preguntas" aria-labelledby="faq-title" tabindex="-1">
    <div class="wrap faq-grid">
      <h2 class="display" id="faq-title"><%= localized_text es: "Antes de enviar tu primera tarjeta", en: "Before you send your first gift card" %></h2>
      <div class="faq-list">
        <% [
          ["¿Dónde se puede usar?", "Where can it be used?", "En los lugares indicados para esa tarjeta. Revisa las instrucciones del comercio en la app.", "At the locations listed for that gift card. Check the business’s instructions in the app."],
          ["¿Mi familiar necesita la app?", "Does my family member need the app?", "Sí. Recibe un correo y accede a su tarjeta en la app para mostrar el código de canje.", "Yes. They receive an email and access their gift card in the app to show the redemption code."],
          ["¿Puedo volver a enviarle saldo?", "Can I add more balance?", "Sí. Si ya tiene una tarjeta de ese comercio, tu aporte se suma a su saldo.", "Yes. If they already have a gift card for that business, your purchase adds to its balance."],
          ["¿Cuánto cuesta?", "How much does it cost?", "Consulta en la app el monto de la tarjeta, los cargos aplicables y el total de tu compra.", "Check the app for the gift card amount, applicable fees, and your purchase total."],
          ["¿Se puede retirar en efectivo?", "Can it be withdrawn as cash?", "No. El saldo se usa para compras según las condiciones de la tarjeta.", "No. The balance is for purchases under the gift card’s terms."]
        ].each do |question_es, question_en, answer_es, answer_en| %>
          <details>
            <summary><span><%= localized_text es: question_es, en: question_en %></span><span class="faq-icon" aria-hidden="true"></span></summary>
            <div class="faq-a"><p><%= localized_text es: answer_es, en: answer_en %></p></div>
          </details>
        <% end %>
        <details>
          <summary><span><%= localized_text es: "¿Necesitas ayuda?", en: "Need help?" %></span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-a">
            <%= locale_tag :es, tag: :p do %>Escríbenos a <a href="mailto:hola@papayal.app">hola@papayal.app</a>. Consulta también los <%= link_to "términos de las tarjetas", legal_tarjetas_regalo_path %> y la <%= link_to "política de pagos y reembolsos", legal_pagos_reembolsos_path %>.<% end %>
            <%= locale_tag :en, tag: :p do %>Email <a href="mailto:hola@papayal.app">hola@papayal.app</a>. You can also read the <%= link_to "gift card terms", legal_tarjetas_regalo_path %> and the <%= link_to "payment and refund policy", legal_pagos_reembolsos_path %>.<% end %>
          </div>
        </details>
      </div>
    </div>
  </section>

  <%# ============================== END CARD ============================== %>
  <section class="end" id="descargar" aria-labelledby="end-title" tabindex="-1">
    <div class="wrap end-inner">
      <div class="end-logo" data-end-logo>
        <svg class="shock" data-shock viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="10"/></svg>
        <svg class="end-mark" aria-hidden="true"><use href="#logo"/></svg>
      </div>
      <h2 class="display" id="end-title" data-end-reveal><%= localized_text es: "Envía lo esencial hoy.", en: "Send the essentials today." %></h2>
      <p class="lead" data-end-reveal><%= localized_text es: "Descarga Papayal y elige una tarjeta para alguien especial.", en: "Download Papayal and choose a gift card for someone you care about." %></p>
      <div class="end-actions" data-end-reveal>
        <%= render "marketing/store_badges" %>
        <div class="end-qr">
          <img src="/marketing/download-qr.svg" alt="" width="104" height="104" loading="lazy">
          <span><%= localized_text es: "Escanea para descargar la app.", en: "Scan to download the app." %></span>
        </div>
      </div>
    </div>
  </section>
</div>
