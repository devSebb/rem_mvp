<% set_locale_titles es: "Papayal | Tarjetas de regalo para Ecuador", en: "Papayal | Gift cards for Ecuador" %>
<% content_for :meta_description, "Envía una tarjeta de regalo digital a tu familia en Ecuador. Consulta comercios participantes y descarga Papayal para iPhone o Android." %>
<% content_for :meta_description_en, "Send a digital gift card to your family in Ecuador. Explore participating businesses and download Papayal for iPhone or Android." %>
<% content_for :head do %>
  <link rel="preload" as="image" href="/optimized/mockup-2-480.webp?v=2" type="image/webp">
<% end %>

<div class="landing-page">
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-container landing-hero-grid">
      <div class="landing-hero-copy">
        <h1 id="landing-title"><%= localized_text es: "Envía una tarjeta de regalo a tu familia en Ecuador.", en: "Send a gift card to your family in Ecuador." %></h1>
        <p class="landing-lead"><%= localized_text es: "Compra desde la app una tarjeta digital en dólares para alguien especial en Ecuador.", en: "Buy a digital gift card in US dollars for someone you care about in Ecuador, right from the app." %></p>
        <div id="descargar" class="landing-download" tabindex="-1">
          <% if marketing_store_url(:ios) && marketing_store_url(:android) %>
            <p class="landing-availability"><%= localized_text es: "Disponible para iPhone y Android.", en: "Available for iPhone and Android." %></p>
          <% end %>
          <%= render "marketing/store_badges" %>
        </div>
        <%= link_to root_path(anchor: "como-funciona"), class: "landing-text-link", data: { action: "click->marketing#handleAnchorClick" } do %>
          <%= localized_text es: "Cómo funciona", en: "How it works" %> <span aria-hidden="true">↓</span>
        <% end %>
      </div>
      <div class="landing-hero-art">
        <picture>
          <source type="image/webp" srcset="/optimized/mockup-2-480.webp?v=2">
          <img src="/mockups/Mockup_2.png" width="1521" height="2421" fetchpriority="high" decoding="async"
            alt="Ejemplo de tarjetas y saldo en la app Papayal"
            data-locale-attrs="alt" data-locale-alt-es="Ejemplo de tarjetas y saldo en la app Papayal" data-locale-alt-en="Example gift cards and balance in the Papayal app">
        </picture>
      </div>
    </div>
  </section>

  <section id="mercado" class="landing-merchants landing-section" aria-labelledby="merchants-title" tabindex="-1">
    <div class="landing-container">
      <div class="landing-section-intro">
        <h2 id="merchants-title"><%= localized_text es: "Elige un comercio para los tuyos.", en: "Choose a business for your family." %></h2>
        <p><%= localized_text es: "Revisa dónde se acepta cada tarjeta antes de comprar.", en: "Check where each gift card is accepted before you buy." %></p>
      </div>
    </div>
    <% if @marketing_merchants.any? %>
      <%# Each half of the track repeats the catalog so it is wider than the viewport; the track slides by exactly one half for a seamless loop. %>
      <% marquee_items = @marketing_merchants * (12.0 / @marketing_merchants.size).ceil %>
      <div class="landing-marquee">
        <div class="landing-marquee-track">
          <% 2.times do |copy| %>
            <%= tag.ul class: "landing-marquee-list", data: { merchant_preview: copy.zero? || nil }, aria: { hidden: copy.positive? || nil } do %>
              <% marquee_items.each_with_index do |merchant, index| %>
                <%= tag.li class: "landing-marquee-item", aria: { hidden: (copy.zero? && index >= @marketing_merchants.size) || nil } do %>
                  <% if merchant.logo.attached? %>
                    <%= image_tag url_for(merchant.logo), alt: merchant.store_name, height: 48, loading: "lazy", decoding: "async", class: "landing-marquee-logo" %>
                  <% else %>
                    <span class="landing-marquee-name"><%= merchant.store_name %></span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="landing-container">
      <% if @marketing_merchants.any? %>
        <% @marketing_merchants.filter_map(&:effective_coverage_text).uniq.each do |coverage| %>
          <p class="landing-merchant-note" lang="es"><%= coverage %></p>
        <% end %>
      <% else %>
        <p class="landing-merchant-empty" data-copy-auxiliary><%= localized_text es: "Consulta los comercios disponibles en la app.", en: "Check the app for available businesses." %></p>
      <% end %>
      <%= link_to root_path(anchor: "descargar"), class: "landing-text-link", data: { action: "click->marketing#handleAnchorClick" } do %>
        <%= localized_text es: "Ver opciones en la app", en: "Explore options in the app" %> <span aria-hidden="true">↗</span>
      <% end %>
    </div>
  </section>

  <section id="como-funciona" class="landing-section landing-process" aria-labelledby="steps-title" tabindex="-1">
    <div class="landing-container">
      <h2 id="steps-title"><%= localized_text es: "Así funciona", en: "How it works" %></h2>
      <ol class="landing-steps">
        <li>
          <div class="landing-step-head" aria-hidden="true">
            <span class="landing-step-icon">
              <svg viewBox="0 0 32 32" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5.5 15.5V27h21V15.5"/>
                <path d="M3 27h26"/>
                <path d="M6 5h20l3.5 7.5h-27z"/>
                <path d="M11.5 5 10 12.5M16 5v7.5M20.5 5l1.5 7.5"/>
                <path d="M2.5 12.5a3.375 3.375 0 0 0 6.75 0a3.375 3.375 0 0 0 6.75 0a3.375 3.375 0 0 0 6.75 0a3.375 3.375 0 0 0 6.75 0"/>
                <path class="landing-step-accent" d="M13 27v-6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6"/>
              </svg>
            </span>
            <span class="landing-step-number">01</span>
          </div>
          <h3><%= localized_text es: "Elige el comercio", en: "Choose a business" %></h3>
          <p><%= localized_text es: "Busca una opción que le sirva a tu familia.", en: "Find an option that works for your family." %></p>
        </li>
        <li>
          <div class="landing-step-head" aria-hidden="true">
            <span class="landing-step-icon">
              <svg viewBox="0 0 32 32" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="13" width="19" height="13.5" rx="2.5"/>
                <path d="M9.5 13v13.5M2.5 19h19"/>
                <path d="M9.5 19c-1.5-3.2-5.8-3.8-5.8-1.4 0 1.6 3.6 1.4 5.8 1.4zm0 0c1.5-3.2 5.8-3.8 5.8-1.4 0 1.6-3.6 1.4-5.8 1.4z"/>
                <path class="landing-step-accent" d="M29.5 2.5 19.5 7l4 1.8 1.8 4z"/>
                <path class="landing-step-accent" d="m23.5 8.8 6-6.3"/>
                <path class="landing-step-accent" d="M13 10.5c1.2-1.4 2.6-2.3 4-2.8" stroke-dasharray="0.1 2.6"/>
              </svg>
            </span>
            <span class="landing-step-number">02</span>
          </div>
          <h3><%= localized_text es: "Compra y envía", en: "Buy and send" %></h3>
          <p><%= localized_text es: "Elige el monto, añade su correo y paga en dólares.", en: "Choose an amount, add their email, and pay in US dollars." %></p>
        </li>
        <li>
          <div class="landing-step-head" aria-hidden="true">
            <span class="landing-step-icon">
              <svg viewBox="0 0 32 32" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="7.5" y="2.5" width="17" height="27" rx="3.5"/>
                <path d="M14.5 26h3"/>
                <g class="landing-step-accent">
                  <rect x="11" y="8.5" width="4.25" height="4.25" rx=".75"/>
                  <rect x="16.75" y="8.5" width="4.25" height="4.25" rx=".75"/>
                  <rect x="11" y="14.25" width="4.25" height="4.25" rx=".75"/>
                  <path d="M17 14.5v.01M20.75 14.5v.01M18.9 16.4v.01M17 18.25v.01M20.75 18.25v.01"/>
                </g>
              </svg>
            </span>
            <span class="landing-step-number">03</span>
          </div>
          <h3><%= localized_text es: "Tu familiar la usa", en: "Your family uses it" %></h3>
          <p><%= localized_text es: "Abre la tarjeta en la app y sigue sus instrucciones de canje.", en: "They open the gift card in the app and follow its redemption instructions." %></p>
        </li>
      </ol>
    </div>
  </section>

  <section id="beneficios" class="landing-product landing-section" aria-labelledby="product-title" tabindex="-1">
    <div class="landing-container landing-product-grid">
      <div class="landing-product-copy">
        <h2 id="product-title"><%= localized_text es: "Tus tarjetas, a mano.", en: "Your gift cards, close at hand." %></h2>
        <p><%= localized_text es: "Consulta el saldo disponible y los movimientos de tus tarjetas desde la app.", en: "Check your gift cards’ available balances and activity in the app." %></p>
      </div>
      <figure>
        <picture>
          <source type="image/webp" srcset="/optimized/mockup-1-840.webp">
          <img src="/mockups/Mockup_1.png" width="2930" height="3045" loading="lazy" decoding="async"
            alt="Pantallas de inicio de la app Papayal"
            data-locale-attrs="alt" data-locale-alt-es="Pantallas de inicio de la app Papayal" data-locale-alt-en="Papayal app welcome and home screens">
        </picture>
        <figcaption><%= localized_text es: "Vista de ejemplo de la app.", en: "Example app view." %></figcaption>
      </figure>
    </div>
  </section>

  <section id="preguntas" class="landing-section" aria-labelledby="faq-title" tabindex="-1">
    <div class="landing-container landing-faq-grid">
      <h2 id="faq-title"><%= localized_text es: "Antes de enviar tu primera tarjeta", en: "Before you send your first gift card" %></h2>
      <div class="landing-faq-list">
        <details class="landing-faq">
          <summary><%= localized_text es: "¿Dónde se puede usar?", en: "Where can it be used?" %><span class="landing-faq-icon" aria-hidden="true"></span></summary>
          <p class="landing-faq-answer"><%= localized_text es: "En los lugares indicados para esa tarjeta. Revisa las instrucciones del comercio en la app.", en: "At the locations listed for that gift card. Check the business’s instructions in the app." %></p>
        </details>
        <details class="landing-faq">
          <summary><%= localized_text es: "¿Mi familiar necesita la app?", en: "Does my family member need the app?" %><span class="landing-faq-icon" aria-hidden="true"></span></summary>
          <p class="landing-faq-answer"><%= localized_text es: "Sí. Recibe un correo y accede a su tarjeta en la app para mostrar el código de canje.", en: "Yes. They receive an email and access their gift card in the app to show the redemption code." %></p>
        </details>
        <details class="landing-faq">
          <summary><%= localized_text es: "¿Puedo volver a enviarle saldo?", en: "Can I add more balance?" %><span class="landing-faq-icon" aria-hidden="true"></span></summary>
          <p class="landing-faq-answer"><%= localized_text es: "Sí. Si ya tiene una tarjeta de ese comercio, tu aporte se suma a su saldo.", en: "Yes. If they already have a gift card for that business, your purchase adds to its balance." %></p>
        </details>
        <details class="landing-faq">
          <summary><%= localized_text es: "¿Cuánto cuesta?", en: "How much does it cost?" %><span class="landing-faq-icon" aria-hidden="true"></span></summary>
          <p class="landing-faq-answer"><%= localized_text es: "Consulta en la app el monto de la tarjeta, los cargos aplicables y el total de tu compra.", en: "Check the app for the gift card amount, applicable fees, and your purchase total." %></p>
        </details>
        <details class="landing-faq">
          <summary><%= localized_text es: "¿Se puede retirar en efectivo?", en: "Can it be withdrawn as cash?" %><span class="landing-faq-icon" aria-hidden="true"></span></summary>
          <p class="landing-faq-answer"><%= localized_text es: "No. El saldo se usa para compras según las condiciones de la tarjeta.", en: "No. The balance is for purchases under the gift card’s terms." %></p>
        </details>
        <details class="landing-faq">
          <summary><%= localized_text es: "¿Necesitas ayuda?", en: "Need help?" %><span class="landing-faq-icon" aria-hidden="true"></span></summary>
          <div class="landing-faq-answer">
            <%= locale_tag :es, tag: :p do %>Escríbenos a <a href="mailto:hola@papayal.app">hola@papayal.app</a>. Consulta también los <%= link_to "términos de las tarjetas", legal_tarjetas_regalo_path %> y la <%= link_to "política de pagos y reembolsos", legal_pagos_reembolsos_path %>.<% end %>
            <%= locale_tag :en, tag: :p do %>Email <a href="mailto:hola@papayal.app">hola@papayal.app</a>. You can also read the <%= link_to "gift card terms", legal_tarjetas_regalo_path %> and the <%= link_to "payment and refund policy", legal_pagos_reembolsos_path %>.<% end %>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="landing-closing-section" aria-labelledby="closing-title">
    <div class="landing-container">
      <div class="landing-closing">
        <div class="landing-closing-copy">
          <h2 id="closing-title"><%= localized_text es: "Un detalle que ayuda, incluso a la distancia.", en: "A thoughtful way to help, even from afar." %></h2>
          <p><%= localized_text es: "Descarga Papayal y elige una tarjeta para alguien especial.", en: "Download Papayal and choose a gift card for someone you care about." %></p>
          <div class="landing-closing-links">
            <% if (url = marketing_store_url(:ios)) %>
              <%= link_to url, class: "landing-button", data: marketing_store_link_data(:ios) do %><%= localized_text es: "Descargar para iPhone", en: "Download for iPhone" %><% end %>
            <% end %>
            <% if (url = marketing_store_url(:android)) %>
              <%= link_to url, class: "landing-button landing-button-outline", data: marketing_store_link_data(:android) do %><%= localized_text es: "Descargar para Android", en: "Download for Android" %><% end %>
            <% end %>
          </div>
        </div>
        <a class="landing-download-qr" href="https://papayal.app/#descargar" data-copy-auxiliary>
          <img src="/marketing/download-qr.svg" alt="" width="144" height="144" loading="lazy">
          <span><%= localized_text es: "Escanea para descargar la app.", en: "Scan to download the app." %></span>
        </a>
      </div>
    </div>
  </section>
</div>
