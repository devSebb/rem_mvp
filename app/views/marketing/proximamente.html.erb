<% set_locale_titles es: "Muy pronto | La app de Papayal", en: "Coming soon | The Papayal app" %>
<% content_for :meta_description, "La experiencia Papayal para compradores vive en nuestra app móvil. Muy pronto disponible en App Store y Google Play." %>

<section class="marketing-hero overflow-hidden">
  <div class="marketing-hero-grid"></div>
  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-5 pb-16 pt-14 sm:px-6 md:pt-18 lg:grid-cols-12 lg:px-8 lg:pb-24">
    <div class="relative z-10 lg:col-span-7">
      <p class="marketing-pill" data-reveal><%= localized_text es: "Muy pronto", en: "Coming soon" %></p>
      <h1 class="marketing-hero-title" data-reveal>
        <%= localized_text es: "Papayal vive en tu bolsillo, no en el navegador.", en: "Papayal lives in your pocket, not in the browser." %>
      </h1>
      <p class="marketing-hero-copy" data-reveal>
        <%= localized_text es: "Toda la experiencia — comprar tarjetas, enviarlas a tu familia y canjearlas en comercios — sucede en la app móvil de Papayal. Estamos en los últimos pasos para publicarla.", en: "The full experience — buying cards, sending them to family, and redeeming at merchants — happens in the Papayal mobile app. We are in the final steps before launch." %>
      </p>

      <% if user_signed_in? %>
        <div class="mt-6 flex flex-wrap items-center gap-3 rounded-2xl border border-[#F4B126]/40 bg-[#F4B126]/10 px-5 py-4" data-reveal>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#F4B126]"></span>
          <p class="flex-1 text-sm font-semibold text-[#2C3A43]">
            <%= localized_text es: "Tu cuenta ya está lista. Cuando la app esté disponible, inicia sesión con este mismo correo.", en: "Your account is ready. When the app is live, sign in with this same email." %>
          </p>
          <%= button_to destroy_user_session_path, method: :delete, class: "text-sm font-bold text-[#14343A] underline underline-offset-2 hover:text-[#F4A20F]", form: { class: "contents" } do %>
            <%= localized_text es: "Cerrar sesión", en: "Sign out" %>
          <% end %>
        </div>
      <% end %>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
        <div class="marketing-secondary-btn h-13 cursor-default select-none px-7 text-base opacity-80">
          <svg viewBox="0 0 24 24" class="mr-2 h-5 w-5 fill-current" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8.98-.2 1.92-.89 3.16-.8 1.79.14 3.03.93 3.71 2.36-3.32 2.02-2.53 6.36.55 7.65-.65 1.4-1.48 2.79-2.5 2.96zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <span><%= localized_text es: "App Store — muy pronto", en: "App Store — coming soon" %></span>
        </div>
        <div class="marketing-secondary-btn h-13 cursor-default select-none px-7 text-base opacity-80">
          <svg viewBox="0 0 24 24" class="mr-2 h-5 w-5 fill-current" aria-hidden="true"><path d="M3.61 1.81c-.36.38-.57.96-.57 1.71v16.96c0 .75.21 1.33.57 1.71l.09.08 9.5-9.5v-.22l-9.5-9.5-.09.08zm13.6 6.16-3.19 3.19v.22l3.19 3.19.07-.04 3.78-2.15c1.08-.61 1.08-1.61 0-2.22l-3.78-2.15-.07-.04zm-3.99 3.6L4.5 20.29c.36.11.79.06 1.27-.21l11.36-6.45-3.91-2.06zm0-1.14 3.91-2.06L5.77 1.92c-.48-.27-.91-.32-1.27-.21l8.72 8.72z"/></svg>
          <span><%= localized_text es: "Google Play — muy pronto", en: "Google Play — coming soon" %></span>
        </div>
      </div>

      <div class="marketing-trust-row" data-reveal>
        <% [
          ["Compra en USD", "USD checkout"],
          ["Entrega inmediata", "Instant delivery"],
          ["Canje en comercios aliados", "Redeem at partner merchants"]
        ].each do |es_label, en_label| %>
          <span><%= localized_text es: es_label, en: en_label %></span>
        <% end %>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="marketing-about-card" data-reveal>
        <p class="text-sm font-bold uppercase text-[#F4B126]"><%= localized_text es: "Lo que podrás hacer", en: "What you will be able to do" %></p>
        <ul class="mt-6 space-y-5">
          <% [
            ["Comprar una tarjeta digital en dólares desde cualquier lugar.", "Buy a digital gift card in USD from anywhere."],
            ["Enviarla al instante a tu familia en Ecuador.", "Send it instantly to your family in Ecuador."],
            ["Canjearla con un código seguro en comercios aliados.", "Redeem it with a secure code at partner merchants."]
          ].each do |es_text, en_text| %>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#F4B126]"></span>
              <span class="text-lg font-semibold leading-7 text-white"><%= localized_text es: es_text, en: en_text %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="marketing-section py-16 sm:py-20">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-3">
      <% [
        ["¿Ya tienes cuenta?", "Already have an account?", "Perfecto: usa el mismo correo y contraseña en la app cuando esté publicada.", "Great: use the same email and password in the app once it is published."],
        ["¿Recibiste una tarjeta?", "Did someone send you a card?", "Tu tarjeta está segura y no vence. Podrás verla y canjearla desde la app.", "Your card is safe and does not expire. You will be able to view and redeem it from the app."],
        ["¿Tienes preguntas?", "Questions?", "Escríbenos y te respondemos personalmente.", "Write to us and we will reply personally."]
      ].each_with_index do |(es_title, en_title, es_body, en_body), i| %>
        <article class="marketing-benefit-card" data-reveal>
          <h3 class="marketing-card-title"><%= localized_text es: es_title, en: en_title %></h3>
          <p class="marketing-card-copy"><%= localized_text es: es_body, en: en_body %></p>
          <% if i == 2 %>
            <%= link_to contact_path, class: "mt-4 inline-block text-sm font-bold text-[#F4A20F] hover:underline" do %>
              <%= localized_text es: "Ir a contacto →", en: "Go to contact →" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>
