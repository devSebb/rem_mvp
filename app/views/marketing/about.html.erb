<% content_for :title, "Sobre Nosotros | Papayal — Remesas digitales para Ecuador" %>

<%# ── HERO ── %>
<section class="marketing-hero relative overflow-hidden">
  <div class="hero-gradient hero-gradient-left"></div>
  <div class="hero-gradient hero-gradient-right"></div>

  <div class="mx-auto w-full max-w-7xl px-5 pb-20 pt-16 sm:px-6 md:pt-20 lg:px-8 lg:pb-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="marketing-pill mx-auto" data-reveal>Sobre Nosotros</p>

      <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight text-[#16363B] sm:text-5xl lg:text-6xl" data-reveal>
        Remesas que se convierten en <span class="about-gradient-text">ayuda real</span>
      </h1>

      <p class="mt-6 text-base text-[#2B3C43]/78 sm:text-lg" data-reveal>
        Papayal transforma el envío de dinero a Ecuador en tarjetas de regalo digitales.
        Tu familia compra medicinas, alimentos y productos esenciales en tiendas locales de confianza.
        Sin comisiones ocultas, sin complicaciones.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal>
        <%= link_to "Comenzar Ahora", new_user_registration_path, class: "marketing-signup-btn h-12 px-7 text-base" %>
        <%= link_to "Ver cómo funciona", root_path(anchor: "como-funciona"), class: "marketing-secondary-btn h-12 px-7 text-base", data: { action: "click->marketing#handleAnchorClick" } %>
      </div>
    </div>
  </div>
</section>

<%# ── QUÉ HACEMOS ── %>
<section class="marketing-section py-20 sm:py-24">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="marketing-pill mx-auto" data-reveal>Nuestra Misión</p>
      <h2 class="mt-5 text-3xl font-black text-[#17363C] sm:text-4xl" data-reveal>
        Que la distancia no sea un obstáculo para cuidar a tu familia
      </h2>
      <p class="mt-3 text-lg text-[#6D7580]" data-reveal>
        Sabemos lo que se siente. Envías dinero y te preguntas si llegó, si se usó bien, cuánto se fue en comisiones. Papayal nació para resolver eso.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        { title: "Tú decides dónde", body: "Elige la categoría: farmacia, supermercado, hogar. Tu ayuda llega exactamente donde la necesitan.", icon: "🎯" },
        { title: "Llega al instante", body: "Tu familia recibe la tarjeta digital en su teléfono en segundos. Sin esperas, sin intermediarios.", icon: "⚡" },
        { title: "Control total", body: "Revisa el estado de cada tarjeta, dónde se usó y cuánto queda. Transparencia completa en cada envío.", icon: "👁️" },
        { title: "Comercios reales", body: "Solo trabajamos con tiendas locales verificadas en Ecuador. Farmacias, supermercados y más.", icon: "📍" },
        { title: "Sin sorpresas", body: "Lo que ves es lo que pagas. Sin comisiones ocultas, sin cargos extras, sin letras chiquitas.", icon: "💲" },
        { title: "Soporte humano", body: "Atención en español, de personas reales, cuando lo necesites. Estamos aquí para ayudarte.", icon: "🎧" }
      ].each_with_index do |feature, i| %>
        <article class="marketing-feature-card" data-reveal style="transition-delay: <%= i * 70 %>ms">
          <div class="marketing-feature-icon"><span><%= feature[:icon] %></span></div>
          <h3 class="mt-5 text-2xl font-bold text-[#17363C]"><%= feature[:title] %></h3>
          <p class="mt-2 text-[#4E5E67]"><%= feature[:body] %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# ── POR QUÉ EXISTIMOS ── %>
<section class="marketing-section py-20 sm:py-24">
  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-5 sm:px-6 lg:grid-cols-2 lg:items-start lg:px-8">
    <div>
      <p class="marketing-pill" data-reveal>Por Qué Existimos</p>
      <h2 class="mt-5 text-3xl font-black text-[#17363C] sm:text-4xl" data-reveal>
        Más que una app de envíos — un puente entre familias.
      </h2>
      <p class="mt-4 text-lg text-[#67707C]" data-reveal>
        Las remesas tradicionales son opacas, lentas y caras. No sabes si el dinero llegó, ni cómo se usó.
        Papayal nació de esa frustración: queríamos una forma directa, segura y transparente de ayudar a
        nuestras familias en Ecuador.
      </p>
      <ul class="mt-8 space-y-5">
        <% [
          { title: "Ayuda directa", body: "Las tarjetas se usan en productos esenciales: medicinas, alimentos, higiene. Nada se pierde en el camino.", icon: "❤️" },
          { title: "Economía local", body: "Cada tarjeta fortalece comercios ecuatorianos. Tu envío apoya a familias y comunidades enteras.", icon: "🏪" },
          { title: "Hecho por latinos", body: "Entendemos la experiencia de la diáspora porque la vivimos. Papayal está diseñada desde esa realidad.", icon: "🌎" }
        ].each do |item| %>
          <li class="flex gap-4" data-reveal>
            <span class="mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#F4B126]/18"><%= item[:icon] %></span>
            <div>
              <h3 class="text-xl font-bold text-[#17363C]"><%= item[:title] %></h3>
              <p class="mt-1 text-[#67707C]"><%= item[:body] %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="space-y-4 lg:pt-4">
      <% [
        { title: "Seguridad real", body: "Encriptación avanzada y verificación de identidad en cada transacción.", icon: "🛡️" },
        { title: "Disponible siempre", body: "Envía tarjetas en cualquier momento, desde cualquier lugar del mundo.", icon: "🕒" },
        { title: "Simple de usar", body: "Diseñada para todos. Tres pasos y listo, sin complicaciones técnicas.", icon: "📱" }
      ].each do |card| %>
        <article class="marketing-benefit-float-card" data-reveal>
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#16363B] text-xl"><%= card[:icon] %></span>
          <div>
            <h3 class="text-2xl font-bold text-[#17363C]"><%= card[:title] %></h3>
            <p class="mt-1 text-[#67707C]"><%= card[:body] %></p>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# ── CTA BANNER ── %>
<section class="px-5 pb-20 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-7xl">
    <div class="marketing-offer-banner" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#15353A]/70">Empieza hoy</p>
      <h2 class="mt-4 text-3xl font-black text-[#15353A] sm:text-4xl">Tu familia te necesita. Papayal te conecta.</h2>
      <p class="mt-3 text-lg text-[#15353A]/80">
        Regístrate en menos de un minuto y envía tu primera tarjeta de regalo a Ecuador.
      </p>
      <%= link_to "Crear mi cuenta", new_user_registration_path, class: "marketing-deep-btn mt-7 inline-flex h-12 items-center px-8 text-base" %>
    </div>
  </div>
</section>
