<div class="locale-toggle" role="group" aria-label="Idioma" data-locale-attrs="aria-label" data-locale-aria-label-es="Idioma" data-locale-aria-label-en="Language selector">
  <button
    type="button"
    class="locale-toggle-btn is-active"
    data-language-toggle
    data-language="es"
    data-action="click->locale#setLanguage"
    aria-pressed="true">
    ES
  </button>
  <button
    type="button"
    class="locale-toggle-btn"
    data-language-toggle
    data-language="en"
    data-action="click->locale#setLanguage"
    aria-pressed="false">
    EN
  </button>
</div>
