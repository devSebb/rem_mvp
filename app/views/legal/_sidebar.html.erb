<nav class="papayal-card p-4 sticky top-24 h-fit">
  <h2 class="text-sm font-semibold text-[#0D2F32] mb-4 uppercase tracking-wider">
    <%= localized_text es: "Documentos Legales", en: "Legal Documents" %>
  </h2>
  <ul class="space-y-2">
    <% 
      current_action = action_name
      nav_items = [
        { path: legal_path, es: "📋 Resumen", en: "📋 Summary", action: "index" },
        { path: legal_terminos_path, es: "1️⃣ Términos y Condiciones", en: "1️⃣ Terms of Service", action: "terminos" },
        { path: legal_privacidad_path, es: "2️⃣ Política de Privacidad", en: "2️⃣ Privacy Policy", action: "privacidad" },
        { path: legal_tarjetas_regalo_path, es: "3️⃣ Términos de Tarjetas de Regalo", en: "3️⃣ Gift Card Terms", action: "tarjetas_regalo" },
        { path: legal_pagos_reembolsos_path, es: "4️⃣ Política de Pagos y Reembolsos", en: "4️⃣ Payments and Refunds", action: "pagos_reembolsos" },
        { path: legal_uso_aceptable_path, es: "5️⃣ Política de Uso Aceptable", en: "5️⃣ Acceptable Use Policy", action: "uso_aceptable" },
        { path: legal_eliminacion_datos_path, es: "6️⃣ Política de Eliminación de Cuenta y Datos", en: "6️⃣ Account and Data Deletion", action: "eliminacion_datos" }
      ]
    %>
    <% nav_items.each do |item| %>
      <li>
        <% is_active = current_action == item[:action] %>
        <%= link_to item[:path], class: "block px-3 py-2 rounded-xl text-sm font-medium transition #{is_active ? 'bg-[#FCA50F]/10 text-[#0D2F32] border border-[#FCA50F]/20' : 'text-[#2C3A43]/70 hover:bg-black/5 hover:text-[#0D2F32]'}" do %>
          <%= localized_text es: item[:es], en: item[:en] %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
