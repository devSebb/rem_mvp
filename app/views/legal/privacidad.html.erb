<div class="max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <%= render 'sidebar' %>
    </div>

    <!-- Main Content -->
    <div class="lg:col-span-3">
      <div class="papayal-card p-8">
        <div class="mb-6">
          <h1 class="text-3xl font-bold text-[#0D2F32] mb-2">Política de Privacidad</h1>
          <p class="text-sm text-[#2C3A43]/70">Última actualización: <%= Date.today.strftime("%d de %B de %Y") %></p>
        </div>

        <div class="prose prose-slate max-w-none text-[#2C3A43]">
          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">1. Información que Recopilamos</h2>
            <p class="mb-4">Recopilamos:</p>
            <ul class="list-disc pl-6 space-y-2">
              <li>Nombre, correo, teléfono</li>
              <li>Información de cuenta</li>
              <li>Historial de transacciones</li>
              <li>Datos técnicos (IP, dispositivo)</li>
            </ul>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">2. Uso de la Información</h2>
            <p class="mb-4">Utilizamos la información para:</p>
            <ul class="list-disc pl-6 space-y-2">
              <li>Operar la Aplicación</li>
              <li>Procesar pagos</li>
              <li>Enviar notificaciones</li>
              <li>Prevenir fraude</li>
              <li>Cumplir obligaciones legales</li>
            </ul>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">3. Compartición de Datos</h2>
            <p class="mb-4">Podemos compartir datos con:</p>
            <ul class="list-disc pl-6 space-y-2">
              <li>Proveedores de pago</li>
              <li>Comercios afiliados</li>
              <li>Twilio (SMS, verificación y notificaciones)</li>
              <li>Resend (envío de correos electrónicos)</li>
              <li>Autoridades cuando sea legalmente requerido</li>
            </ul>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">4. Almacenamiento y Seguridad</h2>
            <p>
              Aplicamos medidas técnicas y organizativas razonables para proteger los datos.
            </p>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">5. Derechos del Usuario</h2>
            <p class="mb-4">El Usuario puede:</p>
            <ul class="list-disc pl-6 space-y-2">
              <li>Acceder a sus datos</li>
              <li>Solicitar corrección</li>
              <li>Solicitar eliminación</li>
            </ul>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">6. Retención</h2>
            <p>
              Conservamos datos mientras exista la cuenta o por obligaciones legales.
            </p>
          </section>

          <section class="mb-8">
            <h2 class="text-2xl font-bold text-[#0D2F32] mb-4">7. Contacto</h2>
            <p>
              Para consultas sobre privacidad, contáctanos en: <a href="mailto:privacidad@papayal.app" class="text-[#FCA50F] hover:underline">📧 privacidad@papayal.app</a>
            </p>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

