<div class="space-y-8">
  <div
    class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    style="background: linear-gradient(135deg, #FCA50F 0%, #FFC65C 45%, #EBEBE8 100%);"
  >
    <div>
      <p class="papayal-meta text-[#0D2F32]/80">Modo Comercio</p>
      <h1 class="text-3xl font-bold text-[#0D2F32]">Hola, <%= @merchant.store_name %></h1>
      <p class="text-sm text-[#0D2F32]/80 mt-2">Administra tus canjes y liquidaciones desde un panel cálido y profesional.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <%= merchant_logo_image(@merchant, size: 48, classes: "shadow-sm") %>
      <%= link_to "Canjear Tarjeta", new_merchant_redemption_path,
          class: "papayal-btn-primary bg-[#EBEBE8] text-[#0D2F32] border border-[#0D2F32]/20 hover:bg-[#EBEBE8]/90" %>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Canjes de hoy</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2"><%= @today_redemptions %></p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Movimientos confirmados</p>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Liquidación pendiente</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2">
        <%= number_to_currency(@pending_settlement / 100.0, unit: '$') %>
      </p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">En cola para pago</p>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Tarjetas únicas</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2"><%= @unique_gift_cards_redeemed %></p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Clientes impactados</p>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Total canjeado</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2">
        <%= number_to_currency(@total_redemption_amount / 100.0, unit: '$') %>
      </p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Acumulado histórico</p>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8 papayal-card p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="papayal-meta text-[#2C3A43]/60">Acciones rápidas</p>
          <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Operaciones clave</h2>
        </div>
      </div>
      <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 md:col-span-4 p-4 rounded-2xl border border-black/5 bg-[#EBEBEB]/60">
          <p class="font-semibold text-[#0D2F32]">Canjear</p>
          <p class="text-sm text-[#2C3A43]/70 mt-1">Procesa tarjetas en mostrador o teléfono.</p>
          <%= link_to "Iniciar canje", new_merchant_redemption_path, class: "papayal-btn-primary mt-4 w-full" %>
        </div>
        <div class="col-span-12 md:col-span-4 p-4 rounded-2xl border border-black/5 bg-[#EBEBEB]/60">
          <p class="font-semibold text-[#0D2F32]">Liquidaciones</p>
          <p class="text-sm text-[#2C3A43]/70 mt-1">Consulta pagos y estados.</p>
          <%= link_to "Ver liquidaciones", merchant_settlements_path, class: "papayal-btn-secondary mt-4 w-full" %>
        </div>
        <div class="col-span-12 md:col-span-4 p-4 rounded-2xl border border-black/5 bg-[#EBEBEB]/60">
          <p class="font-semibold text-[#0D2F32]">Perfil</p>
          <p class="text-sm text-[#2C3A43]/70 mt-1">Mantén tus datos y claves al día.</p>
          <%= link_to "Actualizar perfil", merchant_profile_path, class: "papayal-btn-ghost mt-4 w-full justify-center" %>
        </div>
      </div>
    </div>

    <div class="col-span-12 lg:col-span-4 papayal-card p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Liquidaciones</p>
      <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Estado del próximo pago</h2>
      <div class="mt-4 space-y-3 text-sm text-[#2C3A43]/80">
        <div class="flex items-center justify-between">
          <span>Importe pendiente</span>
          <span class="font-semibold text-[#0D2F32]"><%= number_to_currency(@pending_settlement / 100.0, unit: '$') %></span>
        </div>
        <div class="flex items-center justify-between">
          <span>Última liquidación</span>
          <span><%= @merchant.settlements.order(created_at: :desc).first&.created_at&.strftime('%d %b %Y') || 'N/A' %></span>
        </div>
        <div class="flex items-center justify-between">
          <span>Próximo corte</span>
          <span><%= (@merchant.settlements.order(created_at: :desc).first&.created_at || Time.current).advance(days: 7).strftime('%d %b %Y') %></span>
        </div>
      </div>
      <%= link_to "Ver detalle", merchant_settlements_path, class: "papayal-btn-primary w-full mt-4" %>
    </div>
  </div>

  <% if @recent_redemptions.any? %>
    <div class="papayal-card p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="papayal-meta text-[#2C3A43]/60">Redenciones recientes</p>
          <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Movimientos últimos</h2>
        </div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-black/5">
        <table class="min-w-full divide-y divide-black/5 text-sm">
          <thead class="bg-[#EBEBEB]/60 text-left text-xs font-semibold text-[#2C3A43]/70 uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3">Detalle</th>
              <th class="px-4 py-3">Cliente</th>
              <th class="px-4 py-3">Emisor</th>
              <th class="px-4 py-3">Monto</th>
              <th class="px-4 py-3">Estado</th>
              <th class="px-4 py-3 text-right">Detalle</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-black/5">
            <% @recent_redemptions.each do |transaction| %>
              <% is_cross_merchant = transaction.gift_card.merchant_id != @merchant.id %>
              <tr class="hover:bg-[#EBEBEB]/40 transition">
                <td class="px-4 py-4">
                  <p class="font-semibold text-[#0D2F32]">
                    <%= number_to_currency(transaction.amount / 100.0, unit: '$') %>
                  </p>
                  <p class="text-xs text-[#2C3A43]/70">
                    <%= transaction.created_at.strftime('%d %b %Y %I:%M %p') %>
                  </p>
                </td>
                <td class="px-4 py-4 text-[#2C3A43]/80">
                  De <%= transaction.gift_card.sender.name %>
                </td>
                <td class="px-4 py-4">
                  <% if is_cross_merchant %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-50 text-purple-700 border border-purple-100">
                      <%= transaction.gift_card.merchant&.store_name || "Red" %>
                    </span>
                  <% else %>
                    <span class="text-xs text-[#2C3A43]/50">Tu comercio</span>
                  <% end %>
                </td>
                <td class="px-4 py-4">
                  <% if transaction.gift_card.remaining_balance > 0 %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                      Parcial · Restante <%= number_to_currency(transaction.gift_card.remaining_balance / 100.0, unit: '$') %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                      Completo
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#0D2F32]/10 text-[#0D2F32]">
                    Canjeado
                  </span>
                </td>
                <td class="px-4 py-4 text-right">
                  <%= link_to "Detalles",
                      merchant_gift_card_path(transaction.gift_card),
                      class: "papayal-btn-secondary text-xs whitespace-nowrap" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="papayal-card p-8 text-center space-y-3">
      <p class="text-xl font-semibold text-[#2C3A43]">Aún no hay canjes recientes</p>
      <p class="text-sm text-[#2C3A43]/70">Cuando registres un canje aparecerá en este panel.</p>
      <%= link_to "Registrar mi primer canje", new_merchant_redemption_path, class: "papayal-btn-primary" %>
    </div>
  <% end %>
</div>
<div class="px-4 sm:px-0">
  <div class="mb-8">
    <h1 class="text-2xl font-bold" style="color: #2C3A43;">Panel del Comercio</h1>
    <p class="mt-1 text-sm text-gray-600">¡Bienvenido de nuevo, <%= @merchant.store_name %>!</p>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-green-500 rounded-md flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Canjes de Hoy</dt>
              <dd class="text-lg font-medium" style="color: #2C3A43;"><%= @today_redemptions %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-blue-500 rounded-md flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path>
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Liquidación Pendiente</dt>
              <dd class="text-lg font-medium" style="color: #2C3A43;">
                <%= number_to_currency(@pending_settlement / 100.0, unit: '$') %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-purple-500 rounded-md flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Total de Canjes</dt>
              <dd class="text-lg font-medium" style="color: #2C3A43;"><%= @unique_gift_cards_redeemed %></dd>
              <dd class="text-xs text-gray-500">Tarjetas únicas</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-yellow-500 rounded-md flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path>
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Total Canjeado</dt>
              <dd class="text-lg font-medium" style="color: #2C3A43;">
                <%= number_to_currency(@total_redemption_amount / 100.0, unit: '$') %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-white shadow rounded-lg mb-8">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium mb-4" style="color: #2C3A43;">Acciones Rápidas</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%= link_to "Canjear Tarjeta", new_merchant_redemption_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white", style: "background-color: #FCA50F;" %>
        <%= link_to "Ver Liquidaciones", merchant_settlements_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md bg-white hover:bg-gray-50", style: "color: #2C3A43;" %>
        <%= link_to "Actualizar Perfil", merchant_profile_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md bg-white hover:bg-gray-50", style: "color: #2C3A43;" %>
      </div>
    </div>
  </div>

  <!-- Recent Redemptions -->
  <% if @recent_redemptions.any? %>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium mb-4" style="color: #2C3A43;">Canjes Recientes</h3>
        <div class="flow-root">
          <ul class="-my-5 divide-y divide-gray-200">
            <% @recent_redemptions.each do |transaction| %>
              <li class="py-4">
                <div class="flex items-center space-x-4">
                  <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                      <span class="text-green-600 font-bold text-sm">$</span>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium truncate" style="color: #2C3A43;">
                      <%= number_to_currency(transaction.amount / 100.0, unit: '$') %> canjeado
                    </p>
                    <p class="text-sm text-gray-500">
                      De: <%= transaction.gift_card.sender.name %> • <%= transaction.created_at.strftime('%d de %B, %Y a las %I:%M %p') %>
                    </p>
                    <% if transaction.gift_card.remaining_balance > 0 %>
                      <p class="text-xs font-medium" style="color: #FCA50F;">
                        Saldo restante: <%= number_to_currency(transaction.gift_card.remaining_balance / 100.0, unit: '$') %>
                      </p>
                    <% end %>
                  </div>
                  <div class="flex-shrink-0 text-right">
                    <% if transaction.gift_card.remaining_balance > 0 %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        Parcial
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        Completo
                      </span>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
</div>
