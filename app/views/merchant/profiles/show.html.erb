<div class="space-y-8">
  <div class="papayal-card p-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="papayal-meta text-[#0D2F32]">Perfil Comercio</p>
      <h1 class="text-3xl font-bold text-[#0D2F32] mt-1">Información del comercio</h1>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Administra los datos de tu comercio y tu logo.</p>
    </div>
    <div class="inline-flex items-center gap-3">
      <%= merchant_logo_image(@merchant, size: 48, classes: "shadow-sm") %>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FCA50F]/20 text-[#0D2F32] text-sm font-medium">
        Comercio
      </span>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8 space-y-6">
      <%= form_with model: [:merchant, @merchant], url: merchant_profile_path, local: true, multipart: true, class: "space-y-6" do |f| %>
        <% if @merchant.errors.any? %>
          <div class="papayal-card border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3">
            <p class="font-semibold">Corrige los siguientes errores:</p>
            <ul class="list-disc pl-5 text-sm mt-2 space-y-1">
              <% @merchant.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="papayal-card p-6 space-y-4">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Logo del comercio</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Imagen de tu tienda</h2>
          </div>
          <div class="flex items-center gap-6">
            <div class="flex-shrink-0">
              <%= merchant_logo_image(@merchant, size: 96, classes: "shadow-md") %>
            </div>
            <div class="flex-1">
              <%= f.label :logo, "Cambiar logo", class: "papayal-label" %>
              <%= f.file_field :logo, accept: "image/*", class: "papayal-input mt-2", onchange: "previewLogo(this)" %>
              <p class="text-xs text-[#2C3A43]/70 mt-1">Formato: JPG, PNG o GIF. Tamaño máximo: 5MB.</p>
              <% if @merchant.logo.attached? %>
                <p class="text-xs text-emerald-600 mt-1">✓ Tienes un logo subido</p>
              <% end %>
            </div>
          </div>
          <div id="logo-preview" class="hidden mt-4">
            <p class="text-sm text-[#2C3A43]/70 mb-2">Vista previa:</p>
            <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-[#FCA50F]">
              <img id="logo-preview-img" src="" alt="Preview" class="w-full h-full object-cover">
            </div>
          </div>
        </div>

        <div class="papayal-card p-6 space-y-4">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Datos del comercio</p>
            <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Información principal</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <%= f.label :store_name, "Nombre de la tienda", class: "papayal-label" %>
              <%= f.text_field :store_name, class: "papayal-input mt-2", placeholder: "Café Central" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :address, "Dirección", class: "papayal-label" %>
              <%= f.text_field :address, class: "papayal-input mt-2", placeholder: "Av. Siempre Viva 123" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :contact_email, "Correo de contacto", class: "papayal-label" %>
              <%= f.email_field :contact_email, class: "papayal-input mt-2", placeholder: "contacto@comercio.com" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :bank_account_iban, "Cuenta IBAN", class: "papayal-label" %>
              <%= f.text_field :bank_account_iban, class: "papayal-input mt-2", placeholder: "US1234567890..." %>
            </div>
          </div>
        </div>

        <div class="pt-6">
          <div class="flex flex-col sm:flex-row gap-3">
            <%= link_to "Volver al panel", merchant_root_path, class: "papayal-btn-secondary w-full sm:w-auto text-center py-3" %>
            <%= f.submit "Guardar cambios", class: "papayal-btn-primary w-full sm:w-auto py-3" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-span-12 lg:col-span-4 space-y-6">
      <div class="papayal-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="papayal-meta text-[#2C3A43]/60">Estado</p>
            <h3 class="text-xl font-bold text-[#2C3A43]">Tu comercio</h3>
          </div>
          <span class="<%= status_badge_classes(@merchant.status) %>"><%= status_badge_label(@merchant.status) %></span>
        </div>
        <div class="space-y-3 text-sm text-[#2C3A43]/80">
          <div class="flex items-center justify-between">
            <span>Tienda</span>
            <span class="font-semibold text-[#0D2F32]"><%= @merchant.store_name %></span>
          </div>
          <div class="flex items-center justify-between">
            <span>Contacto</span>
            <span class="font-semibold text-[#0D2F32]"><%= @merchant.contact_email.presence || "No especificado" %></span>
          </div>
          <div class="flex items-center justify-between">
            <span>Miembro desde</span>
            <span class="font-semibold text-[#0D2F32]"><%= @merchant.created_at.strftime("%d/%m/%Y") %></span>
          </div>
        </div>
      </div>

      <div class="papayal-card p-6 space-y-3">
        <p class="papayal-meta text-[#2C3A43]/60">Cuenta personal</p>
        <h3 class="text-xl font-bold text-[#2C3A43]">Datos del usuario</h3>
        <p class="text-sm text-[#2C3A43]/70">Para actualizar tu nombre, email o contraseña, edita tu perfil de usuario.</p>
        <%= link_to "Editar perfil de usuario", edit_user_registration_path, class: "papayal-btn-secondary w-full text-center" %>
      </div>
    </div>
  </div>
</div>

<script>
  function previewLogo(input) {
    const preview = document.getElementById('logo-preview');
    const previewImg = document.getElementById('logo-preview-img');
    
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      
      reader.onload = function(e) {
        previewImg.src = e.target.result;
        preview.classList.remove('hidden');
      };
      
      reader.readAsDataURL(input.files[0]);
    } else {
      preview.classList.add('hidden');
    }
  }
</script>
