<div class="space-y-8">
  <div
    class="papayal-card p-6"
    style="background: linear-gradient(135deg, #0D2F32 0%, #2C3A43 35%, #FCA50F 100%);"
  >
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="papayal-meta text-white/70">Liquidaciones</p>
        <h1 class="text-3xl font-bold text-white">Resumen de pagos</h1>
        <p class="text-sm text-white/80 mt-1">
          Revisa los canjes pendientes de pago y lo que ya fue liquidado.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Iniciar canje", new_merchant_redemption_path, class: "papayal-btn-primary" %>
        <%= link_to "Volver al panel", merchant_root_path, class: "papayal-btn-secondary bg-white text-[#0D2F32] border-white/60" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 sm:col-span-4 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/70">Pendiente de pago</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2">
        <%= number_to_currency(@total_pending_settlement / 100.0, unit: '$') %>
      </p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Canjes listos para liquidar.</p>
    </div>
    <div class="col-span-12 sm:col-span-4 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/70">Pagado a tu comercio</p>
      <p class="text-3xl font-bold text-emerald-700 mt-2">
        <%= number_to_currency(@total_settled_amount / 100.0, unit: '$') %>
      </p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Importe ya liquidado.</p>
    </div>
    <div class="col-span-12 sm:col-span-4 papayal-card papayal-card-hover p-6">
      <p class="papayal-meta text-[#2C3A43]/70">Monto canjeado</p>
      <p class="text-3xl font-bold text-[#0D2F32] mt-2">
        <%= number_to_currency(@total_redeemed_amount / 100.0, unit: '$') %>
      </p>
      <p class="text-sm text-[#2C3A43]/70 mt-1">Histórico de canjes registrados.</p>
    </div>
  </div>

  <% filters = [
    { key: 'all', label: 'Todas', count: @gift_card_settlements.count },
    { key: 'pending', label: 'Pendientes', count: @gift_card_settlements.count { |gc| gc[:settlement_status] == 'pending' } },
    { key: 'settled', label: 'Liquidadas', count: @gift_card_settlements.count { |gc| gc[:settlement_status] == 'settled' } }
  ] %>
  <div class="papayal-card p-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="papayal-meta text-[#2C3A43]/70">Estados</p>
      <h3 class="text-lg font-semibold text-[#0D2F32]">Filtra tus liquidaciones</h3>
    </div>
    <div class="flex flex-wrap gap-3">
      <% filters.each do |filter| %>
        <% active = @status_filter == filter[:key] %>
        <%= link_to merchant_settlements_path(status: filter[:key]),
            class: "papayal-btn-secondary text-sm #{active ? 'bg-[#0D2F32] text-white border-[#0D2F32]' : ''}" do %>
          <span><%= filter[:label] %></span>
          <span class="ml-2 inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold <%= active ? 'bg-white/20' : 'bg-[#0D2F32]/10 text-[#0D2F32]' %>">
            <%= filter[:count] %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @gift_card_settlements.any? %>
    <div class="grid grid-cols-12 gap-6">
      <% @gift_card_settlements.each do |settlement_data| %>
        <% gift_card = settlement_data[:gift_card] %>
        <% progress_percent = settlement_data[:total_redeemed].positive? ? ((settlement_data[:settled_amount].to_f / settlement_data[:total_redeemed]) * 100).round(1) : 0 %>

        <div class="col-span-12 md:col-span-6 xl:col-span-4 papayal-card papayal-card-hover p-5 border border-black/5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="papayal-meta text-[#2C3A43]/70">Tarjeta #<%= gift_card.id %></p>
              <h3 class="text-xl font-semibold text-[#0D2F32]">De <%= gift_card.sender.name %></h3>
              <p class="text-sm text-[#2C3A43]/70">Para <%= gift_card.recipient.name %></p>
            </div>
            <% if settlement_data[:settlement_status] == 'pending' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                Pendiente
              </span>
            <% else %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                Liquidada
              </span>
            <% end %>
          </div>

          <div class="mt-4 space-y-3">
            <div class="flex items-center justify-between text-sm">
              <span class="text-[#2C3A43]/70">Total canjeado</span>
              <span class="font-semibold text-[#0D2F32]">
                <%= number_to_currency(settlement_data[:total_redeemed] / 100.0, unit: '$') %>
              </span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-[#2C3A43]/70">Pagado</span>
              <span class="font-semibold text-emerald-700">
                <%= number_to_currency(settlement_data[:settled_amount] / 100.0, unit: '$') %>
              </span>
            </div>
            <% if settlement_data[:remaining_to_settle] > 0 %>
              <div class="flex items-center justify-between text-sm">
                <span class="text-[#2C3A43]/70">Pendiente de pago</span>
                <span class="font-semibold text-amber-700">
                  <%= number_to_currency(settlement_data[:remaining_to_settle] / 100.0, unit: '$') %>
                </span>
              </div>
            <% end %>
          </div>

          <% if settlement_data[:total_redeemed] > 0 %>
            <div class="mt-4">
              <div class="flex items-center justify-between text-xs text-[#2C3A43]/70 mb-1">
                <span>Progreso de liquidación</span>
                <span><%= progress_percent %>%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-black/5">
                <div class="h-2 rounded-full bg-amber-400" style="width: <%= progress_percent %>%"></div>
              </div>
            </div>
          <% end %>

          <div class="mt-4 space-y-1 text-sm text-[#2C3A43]/70">
            <p>Último canje: <%= settlement_data[:last_redemption]&.strftime('%d %b %Y %H:%M') || 'N/A' %></p>
            <p>Monto original: <%= number_to_currency(gift_card.amount / 100.0, unit: '$') %></p>
            <% if gift_card.remaining_balance > 0 %>
              <p class="text-[#0D2F32] font-medium">Saldo restante: <%= number_to_currency(gift_card.remaining_balance / 100.0, unit: '$') %></p>
            <% end %>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3">
            <%= link_to "Ver tarjeta", gift_card_path(gift_card), class: "papayal-btn-secondary justify-center text-sm" %>
            <% if settlement_data[:settlement_status] == 'pending' %>
              <button type="button" class="papayal-btn-primary justify-center text-sm">
                Solicitar liquidación
              </button>
            <% else %>
              <span class="papayal-btn-ghost justify-center text-sm text-[#2C3A43]/70 border border-transparent">
                Liquidada
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="papayal-card p-10 text-center space-y-3">
      <p class="text-xl font-semibold text-[#0D2F32]">Aún no registras canjes</p>
      <p class="text-sm text-[#2C3A43]/70">
        Cuando canjees tarjetas aparecerán aquí para su liquidación.
      </p>
      <div class="flex justify-center gap-3">
        <%= link_to "Iniciar canje", new_merchant_redemption_path, class: "papayal-btn-primary" %>
        <%= link_to "Volver al panel", merchant_root_path, class: "papayal-btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>
