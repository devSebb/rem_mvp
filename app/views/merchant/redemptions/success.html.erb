<div class="space-y-8">
  <div
    class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    style="background: linear-gradient(135deg, #7BD88A 0%, #A7F3D0 45%, #EBF9F1 100%);"
  >
    <div>
      <p class="papayal-meta text-[#0D2F32]/80">Canjes</p>
      <h1 class="text-3xl font-bold text-[#0D2F32]">Canje exitoso</h1>
      <p class="text-sm text-[#0D2F32]/80 mt-1">El saldo se actualizó en tiempo real.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Panel", merchant_root_path, class: "papayal-btn-ghost" %>
      <%= link_to "Nuevo canje", new_merchant_redemption_path, class: "papayal-btn-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-7 papayal-card p-6 space-y-4">
      <div class="flex items-center gap-3">
        <div class="h-12 w-12 rounded-full bg-emerald-100 flex items-center justify-center">
          <svg class="h-7 w-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <div>
          <p class="papayal-meta text-[#2C3A43]/60">Estado</p>
          <p class="text-xl font-bold text-[#0D2F32]">
            <%= (@gift_card.present? && @gift_card.remaining_balance.to_i.positive?) ? "Canje parcial" : "Canje completo" %>
          </p>
          <% if @gift_card.present? && @gift_card.remaining_balance.to_i.positive? %>
            <p class="text-sm text-[#2C3A43]/70">Aún queda saldo disponible.</p>
          <% else %>
            <p class="text-sm text-[#2C3A43]/70">La tarjeta quedó en $0.</p>
          <% end %>
        </div>
      </div>

      <% if @gift_card %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="rounded-2xl border border-emerald-100 bg-emerald-50/60 p-4">
            <p class="papayal-meta text-emerald-800">Monto canjeado</p>
            <p class="text-2xl font-bold text-emerald-900 mt-1">
              <%= number_to_currency((@gift_card.amount - @gift_card.remaining_balance) / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
            </p>
          </div>
          <div class="rounded-2xl border border-blue-100 bg-blue-50/60 p-4">
            <p class="papayal-meta text-blue-800">Saldo restante</p>
            <p class="text-2xl font-bold text-blue-900 mt-1">
              <%= number_to_currency(@gift_card.remaining_balance / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-black/5 bg-[#F8FAFB] p-4 space-y-2 text-sm text-[#2C3A43]/80 mt-4">
          <div class="flex justify-between">
            <span class="papayal-meta text-[#2C3A43]/60">Canjeado en</span>
            <span><%= @gift_card.merchant&.store_name || "Tu comercio" %></span>
          </div>
          <div class="flex justify-between">
            <span class="papayal-meta text-[#2C3A43]/60">Fecha</span>
            <span><%= (@gift_card.redeemed_at || Time.current).strftime('%d %b %Y %I:%M %p') %></span>
          </div>
          <div class="flex justify-between">
            <span class="papayal-meta text-[#2C3A43]/60">De</span>
            <span><%= @gift_card.sender.name %></span>
          </div>
          <div class="flex justify-between">
            <span class="papayal-meta text-[#2C3A43]/60">Para</span>
            <span><%= @gift_card.recipient&.name || 'Desconocido' %></span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-span-12 lg:col-span-5 papayal-card p-6 space-y-4">
      <p class="papayal-meta text-[#2C3A43]/70">Siguientes pasos</p>
      <div class="space-y-3">
        <%= link_to "Nuevo canje", new_merchant_redemption_path, class: "papayal-btn-primary w-full justify-center" %>
        <%= link_to "Ver liquidaciones", merchant_settlements_path, class: "papayal-btn-secondary w-full justify-center" %>
        <%= link_to "Panel", merchant_root_path, class: "papayal-btn-ghost w-full justify-center" %>
      </div>
    </div>
  </div>
</div>
