<div class="space-y-8">
  <div
    class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    style="background: linear-gradient(135deg, #FCA50F 0%, #FFC65C 45%, #EBEBE8 100%);"
  >
    <div>
      <p class="papayal-meta text-[#0D2F32]/80">Canjes</p>
      <h1 class="text-3xl font-bold text-[#0D2F32]">Confirmar canje</h1>
      <p class="text-sm text-[#0D2F32]/80 mt-1">Revisa el saldo y confirma el monto a descontar.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "← Buscar otra tarjeta", new_merchant_redemption_path, class: "papayal-btn-secondary" %>
      <%= link_to "Panel", merchant_root_path, class: "papayal-btn-ghost" %>
    </div>
  </div>

  <% if @gift_card %>
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-5 papayal-card p-6 space-y-4">
        <% if @redemption_mode == "token" %>
          <div class="rounded-2xl border border-blue-100 bg-blue-50/70 p-3">
            <p class="papayal-meta text-blue-800">Usando código dinámico</p>
            <p class="text-sm text-blue-900 mt-1 font-mono tracking-[0.25em]"><%= @redemption_token_value %></p>
            <% if @redemption_token&.expires_at %>
              <p class="text-xs text-blue-700 mt-1">Vence <%= @redemption_token.expires_at.strftime('%I:%M %p') %></p>
            <% end %>
          </div>
        <% end %>

        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="papayal-meta text-[#2C3A43]/60">Monto original</p>
              <p class="text-2xl font-bold text-[#0D2F32]">
                <%= number_to_currency(@gift_card.amount / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
              </p>
            </div>
            <div>
              <p class="papayal-meta text-[#2C3A43]/60">Saldo restante</p>
              <p class="text-2xl font-bold text-emerald-700">
                <%= number_to_currency(@gift_card.remaining_balance / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-sm text-[#2C3A43]/80">
            <div>
              <p class="papayal-meta text-[#2C3A43]/60">De</p>
              <p class="font-semibold text-[#0D2F32]"><%= @gift_card.sender.name %></p>
            </div>
            <div>
              <p class="papayal-meta text-[#2C3A43]/60">Para</p>
              <p class="font-semibold text-[#0D2F32]"><%= @gift_card.recipient&.name || 'Desconocido' %></p>
            </div>
            <%# Gift card expiration removed - gift cards never expire %>
          </div>

          <% if @is_cross_merchant %>
            <div class="rounded-2xl border border-purple-100 bg-purple-50/60 p-4">
              <p class="text-sm font-medium text-purple-800">Canje en red</p>
              <div class="text-xs text-purple-700 mt-2 space-y-1">
                <p><span class="font-medium">Emitida por:</span> <%= @issuing_merchant.store_name %></p>
                <p><span class="font-medium">Canjeando en:</span> <%= @redeeming_merchant.store_name %></p>
              </div>
            </div>
          <% end %>

          <div class="rounded-2xl border border-amber-100 bg-amber-50/60 p-4">
            <p class="text-sm font-medium text-amber-800">Verifica los datos</p>
            <p class="text-xs text-amber-700 mt-1">Confirma monto y destinatario antes de canjear.</p>
          </div>
        </div>
      </div>

      <div class="col-span-12 lg:col-span-7 papayal-card p-6 space-y-5">
        <div>
          <p class="papayal-meta text-[#2C3A43]/70">Monto a canjear</p>
          <h2 class="text-2xl font-bold text-[#0D2F32] mt-1">Define el valor</h2>
          <p class="text-sm text-[#2C3A43]/70 mt-1">Puedes canjear cualquier monto hasta el saldo disponible.</p>
        </div>

        <%= form_with url: redeem_merchant_redemptions_path, method: :post, local: true, class: "space-y-5" do |form| %>
          <%= form.hidden_field :gift_card_id, value: @gift_card.id %>
          <%= form.hidden_field :idempotency_token, value: @idempotency_token %>
          <%= form.hidden_field :redemption_mode, value: @redemption_mode %>
          <% if @redemption_mode == "token" %>
            <%= form.hidden_field :redemption_token, value: @redemption_token_value %>
          <% end %>

          <div class="space-y-2">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-[#2C3A43]/60 sm:text-sm"><%= @gift_card.currency == 'USD' ? '$' : @gift_card.currency %></span>
              </div>
              <%= form.number_field :redemption_amount,
                    value: @gift_card.remaining_balance / 100.0,
                    step: 0.01,
                    min: 0.01,
                    max: @gift_card.remaining_balance / 100.0,
                    class: "papayal-input pl-8 text-lg font-semibold",
                    placeholder: "0.00" %>
            </div>
            <p class="text-xs text-[#2C3A43]/60">
              Máximo: <%= number_to_currency(@gift_card.remaining_balance / 100.0, unit: @gift_card.currency == 'USD' ? '$' : @gift_card.currency) %>
            </p>
          </div>

          <div class="rounded-2xl border border-blue-100 bg-blue-50/60 p-3 text-sm text-blue-800">
            El saldo restante seguirá disponible si no canjeas el total.
          </div>

          <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
            <%= link_to "Cancelar", new_merchant_redemption_path, class: "papayal-btn-secondary w-full sm:w-auto justify-center" %>
            <%= form.submit "Confirmar canje",
                class: "papayal-btn-primary w-full sm:w-auto",
                data: {
                  disable_with: "Procesando...",
                  turbo_confirm: "¿Confirmar canje? Esta acción no se puede deshacer."
                } %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="papayal-card p-6 text-center">
      <p class="text-[#2C3A43]/70">No encontramos la tarjeta para confirmar.</p>
      <%= link_to "Intentar de nuevo", new_merchant_redemption_path, class: "papayal-btn-primary mt-4 inline-flex justify-center" %>
    </div>
  <% end %>
</div>
