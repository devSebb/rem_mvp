<div class="px-4 sm:px-0">
  <!-- Quick Actions -->
  <div class="bg-white shadow rounded-lg mb-6">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Quick Actions</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%= link_to "Dashboard", merchant_root_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <%= link_to "View Settlements", merchant_settlements_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <%= link_to "Update Profile", merchant_profile_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      </div>
    </div>
  </div>

  <div class="max-w-md mx-auto">
    <div class="bg-white shadow-md rounded-lg px-8 pt-6 pb-8 mb-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Redeem Gift Card</h2>
    
    <%= form_with url: merchant_redemptions_path, method: :post, local: true, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :code, "Gift Card Code", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :code, 
              class: "mt-1 focus:ring-blue-500 focus:border-blue-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md uppercase",
              placeholder: "REM-XXXX-XXXX-XXXX",
              autofocus: true,
              required: true %>
        <p class="mt-1 text-sm text-gray-500">Enter the gift card code or scan the QR code</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <%= link_to "Back to Dashboard", merchant_root_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full sm:w-auto text-center" %>
        <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
          <%= form.submit "Find Gift Card", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
        </div>
      </div>
    <% end %>
    </div>
  </div>
</div>
