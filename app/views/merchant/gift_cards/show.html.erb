<div class="space-y-8">
  <!-- Header -->
  <div
    class="papayal-card p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    style="background: linear-gradient(135deg, #FCA50F 0%, #FFC65C 45%, #EBEBE8 100%);"
  >
    <div>
      <p class="papayal-meta text-[#0D2F32]/80">Detalle de tarjeta</p>
      <h1 class="text-3xl font-bold text-[#0D2F32]">Tarjeta de <%= @gift_card.merchant&.store_name || "Papayal" %></h1>
      <p class="text-sm text-[#0D2F32]/80 mt-2">Saldo de la tarjeta y los canjes realizados en tu comercio.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "← Volver al Panel", merchant_root_path,
          class: "papayal-btn-secondary bg-[#EBEBE8] text-[#0D2F32] border border-[#0D2F32]/20 hover:bg-[#EBEBE8]/90" %>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <!-- Card balance -->
    <div class="col-span-12 lg:col-span-6 papayal-card p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Información de la tarjeta</p>
      <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Saldo</h2>

      <div class="mt-6 grid grid-cols-2 gap-4">
        <div>
          <p class="text-sm font-medium text-[#2C3A43]/70">Saldo disponible</p>
          <p class="text-2xl font-bold text-emerald-700"><%= number_to_currency(@balances[:spendable_cents] / 100.0, unit: '$') %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2C3A43]/70">Saldo total</p>
          <p class="text-2xl font-bold text-[#0D2F32]"><%= number_to_currency(@balances[:remaining_balance] / 100.0, unit: '$') %></p>
        </div>
        <% if @balances[:held_cents].positive? %>
          <div>
            <p class="text-sm font-medium text-[#2C3A43]/70">Retenido</p>
            <p class="text-lg font-bold text-amber-700"><%= number_to_currency(@balances[:held_cents] / 100.0, unit: '$') %></p>
          </div>
        <% end %>
        <% if @balances[:disputed_cents].positive? %>
          <div>
            <p class="text-sm font-medium text-[#2C3A43]/70">En disputa</p>
            <p class="text-lg font-bold text-rose-700"><%= number_to_currency(@balances[:disputed_cents] / 100.0, unit: '$') %></p>
          </div>
        <% end %>
        <div>
          <p class="text-sm font-medium text-[#2C3A43]/70">Cargado total</p>
          <p class="text-lg font-bold text-[#0D2F32]"><%= number_to_currency(@gift_card.total_loaded_cents / 100.0, unit: '$') %></p>
          <p class="text-xs text-[#2C3A43]/60"><%= @gift_card.loads_count %> recarga<%= "s" unless @gift_card.loads_count == 1 %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2C3A43]/70">Estado</p>
          <span class="<%= status_badge_classes(@gift_card.status) %>">
            <%= status_badge_label(@gift_card.status) %>
          </span>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2C3A43]/70">ID de tarjeta</p>
          <p class="text-sm font-mono text-[#0D2F32]/80"><%= @gift_card.id %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2C3A43]/70">Creada</p>
          <p class="text-sm text-[#2C3A43]/80"><%= @gift_card.created_at.strftime('%d %b %Y') %></p>
        </div>
      </div>
    </div>

    <!-- Recipient Details -->
    <div class="col-span-12 lg:col-span-6 papayal-card p-6">
      <p class="papayal-meta text-[#2C3A43]/60">Información del titular</p>
      <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Quien canjea</h2>

      <% if @recipient %>
        <div class="mt-6 space-y-4">
          <div>
            <p class="text-sm font-medium text-[#2C3A43]/70">Nombre</p>
            <p class="text-lg font-bold text-[#0D2F32]"><%= @recipient.name %></p>
          </div>
          <div>
            <p class="text-sm font-medium text-[#2C3A43]/70">Email</p>
            <p class="text-sm text-[#2C3A43]/80"><%= @recipient.placeholder_email? ? "No registrado" : @recipient.email %></p>
          </div>
          <div>
            <p class="text-sm font-medium text-[#2C3A43]/70">Teléfono</p>
            <p class="text-sm text-[#2C3A43]/80"><%= @recipient.phone || 'No registrado' %></p>
          </div>
        </div>
      <% else %>
        <div class="mt-6">
          <p class="text-sm text-[#2C3A43]/70">Esta tarjeta no tiene titular registrado.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Transactions History (this merchant only) -->
  <div class="papayal-card p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <p class="papayal-meta text-[#2C3A43]/60">Historial en tu comercio</p>
        <h2 class="text-xl font-bold text-[#2C3A43] mt-1">Canjes y devoluciones</h2>
      </div>
    </div>

    <% if @transactions.any? %>
      <div class="overflow-hidden rounded-2xl border border-black/5">
        <table class="min-w-full divide-y divide-black/5 text-sm">
          <thead class="bg-[#EBEBEB]/60 text-left text-xs font-semibold text-[#2C3A43]/70 uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3">ID Transacción (DB)</th>
              <th class="px-4 py-3">Fecha y Hora</th>
              <th class="px-4 py-3">Monto Canjeado</th>
              <th class="px-4 py-3">Estado</th>
              <th class="px-4 py-3">Procesado por</th>
              <th class="px-4 py-3">Acciones</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-black/5">
            <% @transactions.each do |transaction| %>
              <% refund_txn = @refunds_by_redemption_id[transaction.id.to_s] %>
              <tr class="hover:bg-[#EBEBEB]/40 transition">
                <td class="px-4 py-4 text-xs font-mono text-[#2C3A43]/80">
                  <%= transaction.id %>
                </td>
                <td class="px-4 py-4">
                  <p class="font-semibold text-[#0D2F32]">
                    <%= transaction.created_at.strftime('%d %b %Y') %>
                  </p>
                  <p class="text-xs text-[#2C3A43]/70">
                    <%= transaction.created_at.strftime('%I:%M %p') %>
                  </p>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-100">
                    -<%= number_to_currency(transaction.amount / 100.0, unit: '$') %>
                  </span>
                </td>
                <td class="px-4 py-4">
                  <% if transaction.failed? %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">
                      Rechazado<%= " · #{transaction.decline_reason}" if transaction.decline_reason.present? %>
                    </span>
                  <% elsif refund_txn %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                      Devuelto
                    </span>
                    <p class="text-xs text-[#2C3A43]/70 mt-1">
                      <%= refund_txn.created_at.strftime('%d %b %Y %I:%M %p') %>
                    </p>
                  <% else %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                      Canjeado
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-4 text-[#2C3A43]/80">
                  <%= @transaction_users[transaction.metadata['actor_id']]&.name || 'Usuario desconocido' %>
                </td>
                <td class="px-4 py-4">
                  <% if refund_txn || transaction.failed? %>
                    <span class="text-xs text-[#2C3A43]/70">—</span>
                  <% else %>
                    <%= button_to "Devolver",
                          merchant_gift_card_refund_transaction_path(@gift_card, transaction_id: transaction.id),
                          method: :post,
                          params: { reason: "Refund requested by merchant" },
                          class: "papayal-btn-ghost text-center border border-rose-200 text-rose-700 bg-rose-50/60 hover:bg-rose-100 text-xs px-3 py-2",
                          data: { turbo_confirm: "¿Seguro que quieres devolver este canje a la tarjeta? Esta acción no se puede deshacer." } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-4 p-4 bg-[#EBEBEB]/60 rounded-lg">
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-[#2C3A43]/70">Total canjeado en tu comercio (neto):</span>
          <span class="font-bold text-[#0D2F32]"><%= number_to_currency(@total_redeemed_net / 100.0, unit: '$') %></span>
        </div>
        <% if @total_reversed.positive? %>
          <div class="flex items-center justify-between text-sm mt-1">
            <span class="font-medium text-[#2C3A43]/70">Devuelto:</span>
            <span class="font-bold text-rose-700">−<%= number_to_currency(@total_reversed / 100.0, unit: '$') %></span>
          </div>
        <% end %>
        <div class="flex items-center justify-between text-sm mt-1">
          <span class="font-medium text-[#2C3A43]/70">Número de canjes:</span>
          <span class="font-bold text-[#0D2F32]"><%= @transactions.count %></span>
        </div>
      </div>
    <% else %>
      <div class="text-center py-8">
        <p class="text-lg font-semibold text-[#2C3A43]">No hay canjes registrados</p>
        <p class="text-sm text-[#2C3A43]/70 mt-1">Esta tarjeta aún no ha sido canjeada en tu comercio.</p>
      </div>
    <% end %>
  </div>
</div>
