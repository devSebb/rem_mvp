{
  "info": {
    "_postman_id": "b0e6f9f2-2cc8-4d4d-8f3d-2fca0b0df4b6",
    "name": "Papayal Merchant API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Merchant-facing API for validating balances, redeeming gift cards, fetching redemption transactions, and issuing refunds.\n\nAuth\n- Authorization: Bearer {{api_key}}\n\nVariables you should set in Postman\n- base_url (e.g. http://localhost:3000)\n- api_key (merchant secret key)\n- token (short-lived redemption token shown by the customer)\n- transaction_id (the redemption transaction id returned by POST /api/v1/redemptions)\n\nImportant\n- `idempotency_key` is REQUIRED in the JSON body for redemption and refund requests.\n- Refunds are currently FULL refunds of the referenced redemption transaction (no partial refund endpoint yet).\n- This app does NOT currently read an `Idempotency-Key` HTTP header; include it only if your client wants to echo/log it.\n\nTarjetas recargables (2026-09): una tarjeta por cliente y comercio; cada compra es una recarga. Requests sin cambios; campos aditivos spendable_cents/total_balance_cents; declines nuevos merchant_mismatch y card_frozen. Ver docs/merchant_api_es.md."
  },
  "item": [
    {
      "name": "Validate Gift Card",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\",\n  \"amount_cents\": 500\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/gift_cards/validate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "gift_cards",
            "validate"
          ]
        },
        "description": "remaining_balance_cents / balance_cents = saldo canjeable AHORA (spendable). Campos adicionales: spendable_cents, total_balance_cents, held_cents, disputed_cents. Errores nuevos: card_frozen (422), merchant_mismatch (403)."
      },
      "response": []
    },
    {
      "name": "Show Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/gift_cards/{{token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "gift_cards",
            "{{token}}"
          ]
        },
        "description": "remaining_balance_cents / balance_cents = saldo canjeable AHORA (spendable). Campos adicionales: spendable_cents, total_balance_cents, held_cents, disputed_cents. Errores nuevos: card_frozen (422), merchant_mismatch (403)."
      },
      "response": []
    },
    {
      "name": "Redeem (Authorize & Capture)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"idempotency_key\", crypto.randomUUID());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\",\n  \"amount_cents\": 500,\n  \"idempotency_key\": \"{{idempotency_key}}\",\n  \"merchant_reference\": \"pos-demo-001\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/redemptions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "redemptions"
          ]
        },
        "description": "Respuesta añade spendable_cents y total_balance_cents (remaining_balance_cents = spendable). decline_reason nuevos: merchant_mismatch (403), card_frozen."
      },
      "response": []
    },
    {
      "name": "Get Redemption Transaction",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/redemptions/{{transaction_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "redemptions",
            "{{transaction_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Refund Redemption (Full Refund)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"refund_idempotency_key\", crypto.randomUUID());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"{{refund_idempotency_key}}\",\n  \"reason\": \"customer asked\"\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/redemptions/{{transaction_id}}/refund",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "redemptions",
            "{{transaction_id}}",
            "refund"
          ]
        }
      },
      "response": []
    }
  ]
}
